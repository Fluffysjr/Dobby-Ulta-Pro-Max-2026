    return fortRestart()
  }
  function fortRestart() {
    const rs = F.resume
    F.resume = null
    F.scanAt = 0
    fSet('idle')
    if (!rs) return
    if (rs.kind === 'duel') { duelStart(); return }
    if (rs.kind === 'pray') { prayStart(rs); return }
    if (rs.kind === 'wb') { wbStart(rs); return }
    if (cfg.fort.refill === 'hotel') F.pendingHotel = true
    startRun(rs.mode)
  }
  function fortAbort(msg) {
    log(msg, 'e')
