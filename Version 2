    async addTop(n) {
      if (UI.measuring) return
      UI.measuring = true
      try {
        const ranked = await rankSilver(n, null, cfg.f.goal)
        const have = new Set(picks.map(p => p.id))
        let added = 0
        for (const r of ranked) {
          if (added >= n) break
          if (have.has(r.id)) continue
          have.add(r.id)
          picks.push({ id: r.id, x: r.x, y: r.y, tier: r.tier, stop: null, set: 0 })
          added++
        }
        savePicks()
        log(t('topAdded', added))
        if (!R.on) { cfg.runMode = 'list'; saveCfg() }
        UI.show('work')
      } finally { UI.measuring = false }
