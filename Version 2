  }


  // ===== Day change: daily login bonus + continue after the game reloaded itself =====
  const BONUS_TITLE = /napi belépési bónusz|daily login bonus|login bonus|anmeldebonus|täglicher bonus|bonus za logowanie|bonus zilnic|denní bonus|bonus de connexion|bonus giornaliero|bono diario/i
  const BONUS_BTN = /^(átvétel|átvesz|collect|claim|abholen|einsammeln|odbierz|colectează|vyzvednout|récupérer|riscuoti|recoger|cobrar)$/i
  let bonusBusy = false
  // the reward popup after collecting ("Aktivitás bónusz – Jutalom", OK button)
