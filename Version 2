      const byId = new Map(found.map(x => [x.id, x]))
      const so = cfg.f.isort
      const cmp = (a, b) => so === 'count' ? (b.c - a.c) || a.name.localeCompare(b.name) : a.name.localeCompare(b.name)
      const ordersOf = id => shown.map(k => [k, listOf(k).map(Number).indexOf(id)]).filter(([, i]) => i >= 0)
      const sel = []
      const rest = []
      const ids = new Set(found.map(x => x.id))
      for (const k of shown) for (const id of listOf(k).map(Number)) ids.add(id)
      for (const id of ids) {
        const f = byId.get(id)
        const it = f || (() => { const o = itemObj(id) || {}; return { id, name: o.name || ('#' + id), img: o.image || '', c: bagCount(id), kinds: shown.filter(k => listOf(k).map(Number).includes(id)), txt: kindText(o, shown) } })()
        const ord = ordersOf(id)
        if (ord.length) sel.push({ ...it, ord }); else rest.push(it)
      }
      sel.sort((a, b) => (shown.indexOf(a.ord[0][0]) - shown.indexOf(b.ord[0][0])) || (a.ord[0][1] - b.ord[0][1]))
      rest.sort(cmp)
      const rows = [...sel, ...rest]
      if (!rows.length) { wrap.append(ui.note(t('noItemsFound'))); return wrap }
      let h = `<table class="${NS}-t"><thead><tr><th>${esc(one ? t('colUseOrder') : t('colUse'))}</th><th></th><th>${esc(t('colItem'))}</th><th class="n">${esc(t('colCount'))}</th><th>${esc(t('colBonus'))}</th><th></th></tr></thead><tbody>`
      for (const r of rows) {
        const cd = cdLeft(r.id)
        const on = !!(r.ord && r.ord.length)
        const marks = on ? r.ord.map(([k, i]) => `<span class="${NS}-ord">${one ? '' : esc(t('kindT_' + k)) + ' '}${i + 1}.</span>`).join('') : ''
        const tags = one ? '' : (r.kinds || []).map(k => `<span class="${NS}-tag">${esc(t('kindT_' + k))}</span>`).join('')
        h += `<tr class="${on ? 'sel' : ''}${r.c > 0 ? '' : ' off'}"><td><span class="${NS}-tg" data-a="itog" data-k="${(one ? [filt] : (r.kinds || [])).join(',')}" data-id="${r.id}"><i>${on ? '☑' : '☐'}</i>${marks}</span></td>` +
          `<td>${r.img ? `<img class="ii" src="${esc(r.img)}">` : ''}</td><td>${esc(r.name)}${tags}${cd ? `<br><span class="${NS}-hint">${esc(t('cooldown', fmtDur(cd / 1000)))}</span>` : ''}</td>` +
          `<td class="n">${r.c}</td><td style="white-space:normal;max-width:240px"><span class="${NS}-hint">${esc(r.txt)}</span></td><td style="white-space:nowrap">` +
          (one && on ? `<span class="${NS}-x" data-a="iup" data-k="${filt}" data-id="${r.id}">▲</span> <span class="${NS}-x" data-a="idn" data-k="${filt}" data-id="${r.id}">▼</span> ` : '') +
          (quick && r.c > 0 ? `<span class="${NS}-x" data-a="quick" data-id="${r.id}">${esc(t('btnUseNow'))}</span>` : '') + '</td></tr>'
      }
      h += '</tbody></table>'
      wrap.append(h)
      return wrap
    },

