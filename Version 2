  	function checkAndRecordXP(isReset = false) {
          let data = getXPData();
          if (!data) return;

          let now = new Date();
          let currentKeys = getTimeKeys(now);
          let isUpdated = false;

          let currentAbsoluteXP = getTotalXPForLevel(data.level) + data.xp;

          if (isReset) {
              trackerData = { hourly: [], daily: [], weekly: [], monthly: [], levelUps: [] };
              localStorage.removeItem(DAILY_START_DATE_KEY);
              localStorage.removeItem(DAILY_START_XP_KEY);
  			localStorage.removeItem(HOURLY_START_DATE_KEY);
  			localStorage.removeItem(HOURLY_START_XP_KEY);
              localStorage.removeItem(LOCKED_GOAL_DATE_KEY);
          }

          let categories = ['hourly', 'daily', 'weekly', 'monthly'];
          categories.forEach(cat => {
              let list = trackerData[cat];
              let activeKey = currentKeys[cat];

              if (list.length === 0 || list[list.length - 1].dateKey !== activeKey) {
                  list.push({
                      dateKey: activeKey,
                      level: data.level,
                      xp: data.xp,
                      startAbsXP: currentAbsoluteXP,
                      absXP: currentAbsoluteXP,
                      gained: 0
                  });
                  if (list.length > 1000) list.shift();
                  isUpdated = true;
              } else {
                  let currentRow = list[list.length - 1];

                  if (currentRow.startAbsXP === undefined) {
                      currentRow.startAbsXP = currentRow.absXP !== undefined ? currentRow.absXP : (getTotalXPForLevel(currentRow.level) + currentRow.xp);
                  }

                  let tickGain = currentAbsoluteXP - (currentRow.absXP !== undefined ? currentRow.absXP : currentRow.startAbsXP);

                  if (tickGain > 15000) {
                      currentRow.startAbsXP += tickGain;
                  }

                  let newGained = currentAbsoluteXP - currentRow.startAbsXP;
                  if (newGained > currentRow.gained || tickGain > 15000) {
                      currentRow.absXP = currentAbsoluteXP;
                      currentRow.level = data.level;
                      currentRow.xp = data.xp;
                      currentRow.gained = newGained;
                      isUpdated = true;
                  }
              }
          });

          let lastLevelRecord = trackerData.levelUps[trackerData.levelUps.length - 1];
          if (!lastLevelRecord || lastLevelRecord.level < data.level) {
              let dateStr = `${currentKeys.daily} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
              trackerData.levelUps.push({ level: data.level, date: dateStr });
              isUpdated = true;
          }

          if (isUpdated || isReset) localStorage.setItem(STORAGE_KEY, JSON.stringify(trackerData));


          let activeEl = document.activeElement;
          let isTyping = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT');
          if (!isTyping && $('#tw_xp_window').is(':visible')) {
              updateWindowContent();
          }
      }

