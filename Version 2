  async function duelTick() {
    if (!D.on) return
    if (D.busy) {
      if (Date.now() - D.since > 240000) { D.gen++; D.busy = false; log(t('watchdog'), 'w') }
      return
    }
    if (D.wait > Date.now()) return
    D.busy = true
    D.since = Date.now()
    const g = D.gen
    const ck = () => { if (!D.on || g !== D.gen) throw ABORT }
    try { await duelStep(ck) } catch (e) {
      if (e !== ABORT) { log(t('error', (e && e.message) || e), 'e'); D.wait = Date.now() + 10000 }
