// ==UserScript==
// @name         Dobby Plus 2026
// @namespace    dp2026
// @version      2.5.4
// @description  The West: silver job finder, job queue automation (selected / automatic), bandit duels, fort battles, XP tracker, sets, energy / motivation / health / XP item handling, optional hotel fallback.
// @include      https://*.the-west.*/game.php*
// @include      https://*.tw.innogames.*/game.php*
// @require      https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function () {
  'use strict'
  const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window

  // Background-tab timers. Browsers slow page timers down in hidden tabs (Chrome: at most one wake-up
  // per minute after ~5 minutes), which stalled every wait inside a bot step. Timers inside a Web Worker
  // are not throttled like that, so every setTimeout / setInterval of this script runs through one.
  // These names shadow the browser ones only inside this script; the game itself is not touched.
  const BGT = (() => {
    const nat = {
      st: window.setTimeout.bind(window), si: window.setInterval.bind(window),
      ct: window.clearTimeout.bind(window), ci: window.clearInterval.bind(window)
    }
    const jobs = new Map()
    let wk = null, seq = 0
    const fire = id => {
      const j = jobs.get(id)
      if (!j) return
      if (!j.r) jobs.delete(id)
      try { j.f() } catch (e) { console.error('[Dobby]', e) }
    }
    const startNative = (id, j) => { j.h = j.r ? nat.si(() => fire(id), j.ms) : nat.st(() => fire(id), j.ms) }
    const fallback = () => {
      if (!wk) return
      try { wk.terminate() } catch (e) {}
      wk = null
      for (const [id, j] of jobs) startNative(id, j)
    }
    try {
      const src = 'const h={};onmessage=e=>{const d=e.data;if(d.c===1){h[d.i]=(d.r?setInterval:setTimeout)(()=>postMessage(d.i),d.ms)}else{clearTimeout(h[d.i]);clearInterval(h[d.i]);delete h[d.i]}}'
      const url = URL.createObjectURL(new Blob([src], { type: 'text/javascript' }))
      wk = new Worker(url)
      wk.onmessage = e => fire(e.data)
      wk.onerror = fallback
    } catch (e) { wk = null }
    const add = (f, ms, r, args) => {
      if (typeof f !== 'function') return 0
      const id = ++seq
      const j = { f: () => f(...args), r, ms: Math.max(r ? 4 : 0, +ms || 0), h: 0 }
      jobs.set(id, j)
      if (wk) { try { wk.postMessage({ c: 1, i: id, ms: j.ms, r }) } catch (e) { fallback() } }
      else startNative(id, j)
      return id
    }
    const del = id => {
      const j = jobs.get(id)
      if (!j) return
      jobs.delete(id)
      if (wk) { try { wk.postMessage({ c: 0, i: id }) } catch (e) {} }
      else if (j.h) { nat.ct(j.h); nat.ci(j.h) }
    }
    return {
      ok: () => !!wk,
      setTimeout: (f, ms, ...a) => add(f, ms, false, a),
      setInterval: (f, ms, ...a) => add(f, ms, true, a),
      clearTimeout: del, clearInterval: del
    }
  })()
  const { setTimeout, setInterval, clearTimeout, clearInterval } = BGT
  const NS = 'q7r'
  const WIN = NS + 'w'
  const TITLE = 'Dobby Plus 2026'
  let jq = null

  const sleep = ms => new Promise(r => setTimeout(r, ms))
  const rnd = (a, b) => { const x = +a || 0, y = +b || 0; return Math.min(x, y) + Math.random() * Math.abs(y - x) }
  const pause = async r => { const s = rnd(r && r[0], r && r[1]); if (s > 0.05) await sleep(s * 1000) }
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])
  const num = (v, d) => { const n = parseFloat(String(v).replace(',', '.')); return Number.isFinite(n) ? n : d }
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v))
  const fmt = n => (Math.round(+n || 0)).toLocaleString(lang() === 'hu' ? 'hu-HU' : 'en-US')
  const two = n => String(n).padStart(2, '0')
  const fmtDur = s => { s = Math.max(0, Math.round(+s || 0)); const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return h ? `${h}:${two(m)}:${two(x)}` : `${m}:${two(x)}` }
  const clock = ms => { const d = new Date(ms); return `${two(d.getHours())}:${two(d.getMinutes())}` }
  const ABORT = { abort: true }
  async function pool(list, n, fn) {
    let i = 0
    const worker = async () => { while (i < list.length) { const k = i++; await fn(list[k], k) } }
    await Promise.all(Array.from({ length: Math.max(1, Math.min(n, list.length)) }, worker))
  }

  let base = NS
  const keyOf = k => `${base}.${k}`
  const load = (k, d) => { try { const v = JSON.parse(localStorage.getItem(keyOf(k))); return v == null ? d : v } catch (e) { return d } }
  const save = (k, v) => { try { localStorage.setItem(keyOf(k), JSON.stringify(v)) } catch (e) {} }
  const timers = {}
  const saveSoon = (k, getter) => { clearTimeout(timers[k]); timers[k] = setTimeout(() => save(k, getter()), 1500) }

  const BUFFS = ['xp', 'luck', 'money', 'hit']
  const REFILLS = ['energy', 'mot', 'duel', 'hp']
  const DEF = {
    lang: 'auto', xpIcon: true, runMode: 'list', duration: 15, maxQueue: 9, order: 'nearest', defStop: 75,
    lpDress: true, carrier: true,
    energyAt: 0, energyPick: 'priority', energyOut: 'wait',
    motItemsOn: true, motOut: 'stop',
    hpStop: 20, hpItemsOn: true, hpOut: 'stop', hpCancel: true,
    items: { energy: [], mot: [], duel: [], hp: [] },
    buffs: { xp: { auto: 'off', ids: [], min: 0 }, luck: { auto: 'off', ids: [], min: 0 }, money: { auto: 'off', ids: [], min: 0 }, hit: { auto: 'off', ids: [], min: 0 } },
    travelSet: 0, workSet: 0, sleepSet: 0, hpSet: 0,
    motSets: false, motSetAt: 75, motSetHigh: 0, motSetLow: 0,
    wakeEnergy: 100, wakeHp: 60, bankOn: false, bankAt: 50000, bankKeep: 0,
    fort: { on: false, arrive: 10, set: 0, hpSet: 0, buff1: 0, buff2: 0, after: 'stop', refill: 'hotel', allItems: false },
    loginBonus: true, autoResume: true,
    sell: { clothes: true, products: false, keepN: 0, lock: [] },
    pray: { stop: 'manual', hours: 8, count: 100 },
    wb: { stop: 'manual', hours: 8, count: 100, townName: 'Vizes banditák', town: null, target: 0, residents: [], set: 0 },
    buildOn: false, buildAfter: 8, buildHours: 1, buildSet: 0, buildBank: true,
    dJob: [1, 4], dSet: [1, 2], dItem: [1, 3],
    autoPick: false, autoPickN: 6, minLp: 0, gold: true, resetHour: 3,
    autoGoal: 'xp', xpStop: 75, xpTop: 60, xpRescan: 30, xpMaxDist: 0, xpTravel: false, moneySet: 0, pins: [],
    duel: { set: 0, loseSet: 0, hpSet: 0, regenSet: 0, regenOn: true, hpAt: 30, energyAt: 15, motAt: 40, autoItems: true, motOut: 'continue', loseOn: true, dWait: [2, 5] },
    f: { q: '', tier: 'all', doable: true, sort: 'xp', dir: -1, spots: false, topN: 5, goal: 'xp', ref: 'energy', buf: 'all', isort: 'name' }
  }
  let cfg = JSON.parse(JSON.stringify(DEF))
  function loadCfg() {
    const s = load('c', {}) || {}
    cfg = Object.assign(JSON.parse(JSON.stringify(DEF)), s)
    cfg.items = Object.assign({}, DEF.items, s.items || {})
    for (const k of REFILLS) if (!Array.isArray(cfg.items[k])) cfg.items[k] = []
    cfg.buffs = JSON.parse(JSON.stringify(DEF.buffs))
    for (const k of BUFFS) {
      const b = (s.buffs || {})[k] || {}
      cfg.buffs[k] = { auto: ['off', 'always', 'xp', 'money'].includes(b.auto) ? b.auto : 'off', ids: Array.isArray(b.ids) ? b.ids.map(Number) : [], min: +b.min || 0 }
    }
    cfg.f = Object.assign({}, DEF.f, s.f || {})
    for (const k of ['dJob', 'dSet', 'dItem']) if (!Array.isArray(cfg[k]) || cfg[k].length !== 2) cfg[k] = DEF[k].slice()
    if (!Array.isArray(cfg.pins)) cfg.pins = []
    if (!['xp', 'money'].includes(cfg.autoGoal)) cfg.autoGoal = 'xp'
    if (!['list', 'auto'].includes(cfg.runMode)) cfg.runMode = 'list'
    cfg.fort = Object.assign({}, DEF.fort, s.fort || {})
    cfg.sell = Object.assign({}, DEF.sell, s.sell || {})
    cfg.pray = Object.assign({}, DEF.pray, s.pray || {})
    if (!['manual', 'hours', 'count'].includes(cfg.pray.stop)) cfg.pray.stop = 'manual'
    cfg.wb = Object.assign({}, DEF.wb, s.wb || {})
    if (!['manual', 'hours', 'count'].includes(cfg.wb.stop)) cfg.wb.stop = 'manual'
    if (!Array.isArray(cfg.wb.residents)) cfg.wb.residents = []
    if (!Array.isArray(cfg.sell.lock)) cfg.sell.lock = []
    if (!['xp', 'money'].includes(cfg.f.goal)) cfg.f.goal = 'xp'
    cfg.duel = Object.assign({}, DEF.duel, s.duel || {})
    if (!Array.isArray(cfg.duel.dWait) || cfg.duel.dWait.length !== 2) cfg.duel.dWait = DEF.duel.dWait.slice()
    if (!['continue', 'wait', 'stop'].includes(cfg.duel.motOut)) cfg.duel.motOut = 'continue'
    if (!s.v13) { cfg.lpDress = true; cfg.xpTop = 60; cfg.v13 = true }
    if (+cfg.maxQueue !== 4 && +cfg.maxQueue !== 9) cfg.maxQueue = 9
  }
  const saveCfg = () => save('c', cfg)

  function lang() {
    if (cfg.lang === 'hu' || cfg.lang === 'en') return cfg.lang
    const l = [W.Game && W.Game.locale, document.documentElement.lang].filter(Boolean).join(' ')
    return /(^|[^a-z])hu([_\-. ]|$)/i.test(l) || /\.hu$/i.test(location.hostname) ? 'hu' : 'en'
  }
  function t(k, ...a) {
    const d = TX[lang()] || TX.en
    let s = d[k]
    if (s == null) s = TX.en[k]
    if (s == null) s = k
    return a.length ? s.replace(/\{(\d)\}/g, (m, i) => a[+i] == null ? '' : a[+i]) : s
  }

  const R = {
    on: false, mode: 'list', gen: 0, busy: false, since: 0, state: 'idle', note: '', last: '', target: null,
    travel: null, sleep: null, wait: 0, hpWait: 0, gap: 0, hadQ: false, rot: 0, skip: {},
    replan: false, scanDue: false, bank: null, bankBlock: 0, ignoreMot: false, prefer: '', startedAt: 0, noSpeed: {}, carriers: {},
    moneyArmed: false
  }
  const logs = []
  function log(msg, kind) {
    const line = { t: Date.now(), m: String(msg), k: kind || '' }
    logs.push(line)
    if (logs.length > 400) logs.shift()
    R.last = line.m
    UI.onLog(line)
  }
  const warned = new Map()
  function warnOnce(msg, ms) {
    const n = Date.now()
    if (n - (warned.get(msg) || 0) < (ms || 60000)) return
    warned.set(msg, n)
    log(msg, 'w')
  }
  function toast(msg, bad) {
    try { new W.UserMessage(msg, bad ? W.UserMessage.TYPE_ERROR : W.UserMessage.TYPE_HINT).show() } catch (e) {}
  }
  function setState(s, note) { R.state = s; R.note = note || '' }

  const G = {
    pos() { const c = W.Character, p = c.position || {}; return { x: +(p.x != null ? p.x : c.x) || 0, y: +(p.y != null ? p.y : c.y) || 0 } },
    energy: () => +W.Character.energy || 0,
    maxEnergy: () => +W.Character.maxEnergy || 100,
    ePct: () => Math.round(G.energy() / G.maxEnergy() * 100),
    hp: () => +(W.Character.health != null ? W.Character.health : W.Character.hp) || 0,
    maxHp: () => +(W.Character.maxHealth || W.Character.maxHp) || 1,
    hPct: () => Math.round(G.hp() / G.maxHp() * 100),
    money: () => +W.Character.money || 0,
    exp() {
      const c = W.Character
      const v = +(c.experience != null ? c.experience : (typeof c.getExperience === 'function' ? c.getExperience() : NaN))
      return Number.isFinite(v) ? v : null
    },
    way(a, b) {
      try { const v = W.GameMap.calcWayTime(a, b); if (Number.isFinite(v)) return v } catch (e) {}
      return Math.hypot(a.x - b.x, a.y - b.y) / 5
    },
    at(p) { const c = G.pos(); return Math.abs(c.x - p.x) <= 2 && Math.abs(c.y - p.y) <= 2 },
    queue() { const q = W.TaskQueue.queue; return (Array.isArray(q) ? q : Object.values(q || {})).filter(Boolean) },
    qlen: () => G.queue().length,
    qcap() {
      const l = +W.TaskQueue.limit
      if (l > 0) return l
      try { return W.Premium.hasBonus('automation') ? 9 : 4 } catch (e) { return 4 }
    },
    entryJob(e) { const d = e.data || {}; return +(e.jobId || d.jobId || d.job_id || e.job_id || (d.job && d.job.id) || 0) },
    isSleep(e) { return e.type === 'sleep' || (typeof W.TaskSleep === 'function' && e instanceof W.TaskSleep) },
    now() { try { return new W.ServerDate().getTime() } catch (e) { return Date.now() } },
    home() {
      const h = W.Character.homeTown || {}
      const id = +(h.town_id || h.townId || h.id || 0)
      return id ? { id, x: +h.x, y: +h.y, name: h.name || h.town_name || '' } : null
    }
  }

  const jobCache = new Map()
  function jobOf(id) {
    let j = jobCache.get(id)
    if (j) return j
    try { j = W.JobList.getJobById(id) } catch (e) { j = null }
    if (j) jobCache.set(id, j)
    return j || {}
  }
  const jobName = id => jobOf(id).name || ('#' + id)
  const jobIcon = id => { const s = jobOf(id).shortname; return s ? `../images/jobs/${s}.png` : '' }
  function canDo(id) {
    try { const j = W.JobList.getJobById(id); return !j || typeof j.canDo !== 'function' || !!j.canDo() } catch (e) { return true }
  }
  function allJobs() {
    const out = new Map()
    try {
      const a = typeof W.JobList.getSortedJobs === 'function' ? W.JobList.getSortedJobs() : Object.values(W.JobList.jobs || {})
      for (const j of a || []) { const id = +(j && (j.id != null ? j.id : j.jobId)); if (id > 0) out.set(id, { id, name: j.name || j.shortname || ('#' + id) }) }
    } catch (e) {}
    if (!out.size) for (let id = 1; id <= 600; id++) { const j = jobOf(id); if (j && j.name) out.set(id, { id, name: j.name }) }
    for (const s of spots) if (!out.has(s.id)) out.set(s.id, { id: s.id, name: jobName(s.id) })
    return [...out.values()]
  }

  function call(kind, win, action, params, ms) {
    return new Promise(res => {
      let done = false
      const fin = v => { if (!done) { done = true; res(v || null) } }
      setTimeout(() => fin(null), ms || 10000)
      try {
        if (kind === 'get') W.Ajax.get(win, action, params || {}, fin)
        else if (kind === 'mode') W.Ajax.remoteCallMode(win, action, params || {}, fin)
        else W.Ajax.remoteCall(win, action, params || {}, fin)
      } catch (e) { fin(null) }
    })
  }

  const DIDX = { 15: 0, 600: 1, 3600: 2 }
  const EPJ = { 15: 1, 600: 5, 3600: 12 }
  const TIERF = [1, 1.5, 2]
  const epj = () => EPJ[cfg.duration] || 1
  let idx = { t: 0, jobs: {} }
  async function readIndex() {
    const r = await call('mode', 'work', 'index', {})
    if (!r || r.error || !r.jobs) return false
    const jobs = {}
    for (const k in r.jobs) {
      const j = r.jobs[k]
      if (!j) continue
      const d = Array.isArray(j.durations) ? j.durations : []
      jobs[k] = {
        mot: j.motivation != null ? Math.round(+j.motivation * 100) : null,
        lp: j.workpoints != null ? +j.workpoints : null,
        xp: d.map(x => +x.xp || 0),
        money: d.map(x => +x.money || 0)
      }
    }
    idx = { t: Date.now(), jobs }
    return true
  }
  const motOf = id => { const j = idx.jobs[id]; return j && j.mot != null ? j.mot : null }
  const lpOf = id => { const j = idx.jobs[id]; return j && j.lp != null ? j.lp : null }
  let meas = {}
  function measOf(id, tier, maxAge) {
    const m = meas[`${id}:${tier || 0}`]
    return m && m.dur === cfg.duration && Date.now() - m.t < (maxAge || 8 * 3600000) && m.t > resetStart() ? m : null
  }
  function xpOf(id, tier) {
    const m = measOf(id, tier)
    if (m) return { v: m.xp, exact: true }
    const j = idx.jobs[id], i = DIDX[cfg.duration] || 0
    if (j && j.xp[i] != null) return { v: Math.round(j.xp[i] * TIERF[tier || 0]), exact: !tier }
    return { v: 0, exact: false }
  }
  function moneyOf(id, tier) {
    const m = measOf(id, tier)
    if (m) return m.money
    const j = idx.jobs[id], i = DIDX[cfg.duration] || 0
    return j && j.money[i] != null ? Math.round(j.money[i] * TIERF[tier || 0]) : 0
  }
  function requiredPoints(id, r) {
    try {
      const m = W.JobsModel && typeof W.JobsModel.getById === 'function' && W.JobsModel.getById(id)
      const wp = m && +m.workpoints
      if (wp > 0) return wp
    } catch (e) {}
    const b = +((r && r.malus) != null ? r.malus : jobOf(id).malus)
    return Number.isFinite(b) ? b + 1 : NaN
  }
  async function measureSpot(s) {
    const r = await call('mode', 'job', 'job', { jobId: s.id, x: s.x, y: s.y }, 9000)
    if (!r || r.error) return null
    const durs = Array.isArray(r.durations) ? r.durations : []
    const d = durs.find(x => +x.duration === cfg.duration) || durs[DIDX[cfg.duration] || 0] || {}
    const m = { xp: +(d.xp != null ? d.xp : d.experience) || 0, money: +(d.money != null ? d.money : d.dollar) || 0, t: Date.now(), dur: cfg.duration, lp: null, g: MG.cur }
    if (r.jobSkillPoints != null) {
      const need = requiredPoints(s.id, r)
      if (Number.isFinite(need)) m.lp = Math.round(+r.jobSkillPoints - need + 1)
    }
    meas[`${s.id}:${s.tier || 0}`] = m
    const mv = r.motivation != null ? r.motivation : r.jobmotivation
    if (mv != null && Number.isFinite(+mv)) {
      const v = Math.round(+mv <= 1 ? +mv * 100 : +mv)
      if (idx.jobs[s.id]) idx.jobs[s.id].mot = v
      else idx.jobs[s.id] = { mot: v, lp: null, xp: [], money: [] }
    }
    saveSoon('m', () => meas)
    return m
  }

  let spots = []
  let spotsAt = 0
  let feat = { scan: 0, t: 0, map: {} }
  const spotKey = s => `${s.id}@${s.x}-${s.y}`
  async function loadSpots() {
    const r = await call('get', 'map', 'get_minimap', {}, 15000)
    if (!r || !r.job_groups) return false
    const out = []
    for (const gid in r.job_groups) {
      let jobs = []
      try { jobs = W.JobList.getJobsByGroupId(+gid) || [] } catch (e) {}
      for (const p of r.job_groups[gid] || []) {
        const x = +(Array.isArray(p) ? p[0] : p.x), y = +(Array.isArray(p) ? p[1] : p.y)
        if (!Number.isFinite(x) || !Number.isFinite(y)) continue
        for (const j of jobs) {
          const id = +(j && typeof j === 'object' ? j.id : j)
          if (id > 0) out.push({ id, x, y })
        }
      }
    }
    if (out.length) { spots = out; spotsAt = Date.now() }
    return out.length > 0
  }
  function extractFeat(root) {
    const found = {}
    const put = (id, x, y, tier) => {
      if (!(id > 0) || !Number.isFinite(x) || !Number.isFinite(y)) return
      const k = `${id}@${x}-${y}`
      if (!(found[k] >= tier)) found[k] = tier
    }
    const walk = (node, path, depth) => {
      if (!node || typeof node !== 'object' || depth > 8) return
      if ('silver' in node || 'gold' in node) {
        let px, py, pid
        for (const p of path) {
          const m = /^(\d+)[-_](\d+)$/.exec(p)
          if (m) { px = +m[1]; py = +m[2] } else if (/^\d+$/.test(p)) pid = +p
        }
        const x = +(node.x != null ? node.x : px), y = +(node.y != null ? node.y : py)
        const id = +(node.job_id != null ? node.job_id : (node.jobId != null ? node.jobId : pid))
        for (const [k, tier] of [['silver', 1], ['gold', 2]]) {
          const v = node[k]
          if (!v) continue
          if (v === true || v === 1 || v === '1') put(id, x, y, tier)
          else if (typeof v === 'object') (Array.isArray(v) ? v : Object.keys(v)).forEach(j => put(+j, x, y, tier))
        }
        return
      }
      for (const k in node) {
        if (depth === 0 && k === 'static') continue
        walk(node[k], path.concat(k), depth + 1)
      }
    }
    walk(root, [], 0)
    return found
  }
  async function postTiles(tiles) {
    const r = await fetch(location.pathname + '?window=map&ajax=get_complete_data', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' },
      body: 'tiles=' + encodeURIComponent(JSON.stringify(tiles))
    })
    return r.json()
  }
  let scanning = false
  async function scanMap() {
    if (scanning) return false
    scanning = true
    try {
      if (!spots.length || Date.now() - spotsAt > 6 * 3600000) await loadSpots()
      if (!spots.length) { log(t('scanNoSpots'), 'e'); return false }
      const ts = +W.GameMap.tileSize || 256
      const tiles = [...new Set(spots.map(s => `${Math.floor(s.x / ts)},${Math.floor(s.y / ts)}`))].map(k => k.split(',').map(Number))
      const batches = []
      for (let i = 0; i < tiles.length; i += 60) batches.push(tiles.slice(i, i + 60))
      log(t('scanStart', tiles.length, batches.length))
      const found = {}
      let errors = 0, done = 0, cleared = false
      await pool(batches, 2, async b => {
        try {
          const data = await postTiles(b)
          let f = extractFeat(data)
          if (!Object.keys(f).length && W.GameMap.Data && typeof W.GameMap.Data.importData === 'function') {
            const fe = W.GameMap.JobHandler && W.GameMap.JobHandler.Featured
