  // ===== Bandit duels (former BP script, rewritten) =====
  const D = { on: false, gen: 0, busy: false, since: 0, state: 'idle', note: '', wait: 0, errors: 0, counter: 0, loseEvery: '', loseStreak: '' }
  let dstats = { s: { duels: 0, wins: 0, xp: 0 }, t: { duels: 0, wins: 0, xp: 0 } }
