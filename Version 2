    const all = catalog([kind])
    if (!all.length) return p
    const ready = all.filter(x => !cdLeft(x.id)).sort((a, b) => (b.v[kind] || 0) - (a.v[kind] || 0))
    if (ready.length) return { id: ready[0].id }
