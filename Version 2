        toast(t('fortReadyStop', b.name, clock(b.start)))
        F.resume = null
        F.scanAt = 0
        fSet('idle')
        return
      }
      log(t('fortReadyWait', b.name))
      F.checkAt = 0
      fSet('battle', clock(b.start))
      return
    }
