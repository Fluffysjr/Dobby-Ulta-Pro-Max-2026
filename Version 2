  async function duelStep(ck) {
    const dc = cfg.duel
    // one data request per round (the old script asked twice and re-asked every second while waiting)
    const d = await call('remote', 'duel', 'get_data', {})
    ck()
    if (!d || d.error) return duelError(d)
    if (d.motivation_npc != null) W.Character.npcDuelMotivation = d.motivation_npc
    const mot = duelMot()

    if (+dc.hpAt > 0 && G.hPct() <= +dc.hpAt) {
      const r = await duelRefill('hp', ck, b => G.hp() > b.h)
      if (!r.used) await duelWaitLow(r, t('duelLowHp', G.hPct()), ck)
      return
    }
    if (+dc.energyAt > 0 && G.ePct() <= +dc.energyAt) {
      const r = await duelRefill('energy', ck, b => G.energy() > b.e)
      if (!r.used) await duelWaitLow(r, t('duelLowE', G.ePct()), ck)
      return
    }
    if (+dc.motAt > 0 && mot != null && mot <= +dc.motAt) {
      const r = await duelRefill('duel', ck)
      if (r.used) return
      if (dc.motOut === 'stop') { duelStop(t('duelMotStop', mot)); return }
      if (dc.motOut === 'wait') { await duelWaitLow(r, t('duelMotWait', mot), ck); return }
      warnOnce(t('duelMotLow', mot), 1800000)
    }

    const raw = (d.npcs && d.npcs.npcs) || d.npcs || []
    const list = Array.isArray(raw) ? raw : Object.values(raw)
    const av = []
    let mw = Infinity
    for (const n of list) {
      if (!n) continue
      const de = parseFloat(n.arrival_delta) || 0
      if (de >= 0) av.push(n)
      else mw = Math.min(mw, Math.abs(de))
    }
    if (!av.length) {
      await duelRegen(ck)
      const ms = clamp(Number.isFinite(mw) ? (Math.ceil(mw) + 3) * 1000 : 30000, 5000, 1800000)
      dWaitFor(ms, 'cooldown', fmtDur(ms / 1000))
      return
    }

    const lose = loseActive() && loseCycle().lose
    const set = lose ? +dc.loseSet : +dc.set
    // wear() returns at once when the set is already on, so no re-equip before every duel
    if (set) { await wear(set, t(lose ? 'roleLose' : 'roleDuel'), true); ck() }
    const npc = av[0]
    const name = npc.name || ('#' + npc.duelnpc_id)
    dSet('fight', name)
    const before = G.exp()
    const r = await call('remote', 'duel', 'duel_npc', { duelnpc_id: npc.duelnpc_id }, 15000)
    ck()
    if (!r || r.error) return duelError(r)
    D.errors = 0
    const res = r.duel_result || {}
    const won = !!res.attacker_won || res.winner === 'attacker'
    D.counter++
    save('dc', D.counter)
    await sleep(800)
    const after = G.exp()
    const xp = before != null && after != null && after > before ? after - before : 0
    for (const o of [dstats.s, dstats.t]) { o.duels++; if (won) o.wins++; o.xp += xp }
    saveSoon('ds', () => dstats.t)
    log(t(won ? 'duelWin' : 'duelLoss', D.counter, name, lose ? t('duelLoseTag') : ''))
