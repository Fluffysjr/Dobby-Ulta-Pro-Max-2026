    computeRows() {
      const pos = G.pos()
      const picked = new Set(picks.map(pickKey))
      const f = cfg.f
      const q = String(f.q || '').toLowerCase().trim()
      const by = new Map()
      const out = []
      for (const s of spots) {
        const tier = tierOf(s)
        if (tier === 2 && !cfg.gold) continue
        if (f.tier === 'silver' && !tier) continue
        if (f.tier === 'normal' && tier) continue
        const name = jobName(s.id)
        if (q && !name.toLowerCase().includes(q)) continue
        const lp = lpOf(s.id)
        const doable = canDo(s.id) && (lp == null || lp >= 1 || cfg.lpDress)
        if (f.doable && !doable) continue
        const row = { key: spotKey(s), id: s.id, x: s.x, y: s.y, tier, name, lp, doable }
        if (f.spots && tier) { out.push(row); continue }
        const cur = by.get(s.id)
        if (!cur || tier > cur.tier) { row.dist = G.way(pos, row); by.set(s.id, row); continue }
        if (tier === cur.tier) { row.dist = G.way(pos, row); if (row.dist < cur.dist) by.set(s.id, row) }
      }
      for (const r of by.values()) if (!f.spots || !r.tier) out.push(r)
      for (const r of out) {
        if (r.dist == null) r.dist = G.way(pos, r)
        const x = xpOf(r.id, r.tier)
        r.xp = x.v
        r.exact = x.exact
        r.money = moneyOf(r.id, r.tier)
        r.mot = motOf(r.id)
        r.picked = picked.has(r.key)
      }
      const k = f.sort, dir = f.dir || -1
      const val = r => k === 'name' ? r.name : k === 'money' ? r.money : k === 'mot' ? (r.mot == null ? -1 : r.mot) : k === 'lp' ? (r.lp == null ? -1e9 : r.lp) : k === 'dist' ? r.dist : r.xp
      out.sort((a, b) => { const x = val(a), y = val(b); return (typeof x === 'string' ? x.localeCompare(y) : x - y) * dir })
      return out
    },
