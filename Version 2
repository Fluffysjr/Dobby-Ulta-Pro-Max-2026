          trackerData = { hourly: [], daily: [], weekly: [], monthly: [], levelUps: [] };
      }
      if (!trackerData.levelUps) trackerData.levelUps = [];

      function getXPData() {
          let xpElement = document.querySelector('.TWDS_trackbar_xp');
          let levelElement = document.querySelector('.level');
          if (!xpElement || !levelElement) return getXPDataFromGame();

          let currentXP = parseInt(xpElement.getAttribute('data-have'), 10);
          let maxXP = parseInt(xpElement.getAttribute('data-want'), 10);
          let levelText = levelElement.innerText ? levelElement.innerText.trim() : "";
          let level = parseInt(levelText, 10);

          if (isNaN(currentXP) || isNaN(maxXP) || isNaN(level) || level <= 0) {
              return null;
          }

          let percent = maxXP > 0 ? ((currentXP / maxXP) * 100).toFixed(2) : 100;
          return { xp: currentXP, max_xp: maxXP, percent: percent, level: level };
      }

      function getXPDataFromGame() {
          try {
              const C = window.Character || {};
              const level = parseInt(C.level, 10);
              const abs = Number(C.experience);
              if (!(level > 0) || !Number.isFinite(abs)) return null;
              const base = getTotalXPForLevel(level);
              if (level >= 250) return { xp: Math.max(0, abs - base), max_xp: 0, percent: 100, level: level };
              const next = getTotalXPForLevel(level + 1);
              if (abs < base || abs > next || next <= base) return null;
              const have = abs - base, want = next - base;
              return { xp: have, max_xp: want, percent: ((have / want) * 100).toFixed(2), level: level };
          } catch (e) { return null; }
      }

  function getCharacterInfo() {
          let nameEl = document.querySelector('.char_name');
          let charName = "Játékos";
          if (nameEl) charName = nameEl.innerText.trim();
          else {
              let altEl = document.querySelector('.title.linklike.hasMousePopup') || document.querySelector('#ui_character_name');
              if (altEl) charName = altEl.innerText.trim();
          }

          let levelData = getXPData();
          let level = levelData ? levelData.level : 1;
          let classType = "Ismeretlen";
          if (document.querySelector('#buff_div_adventurer')) classType = "Kalandor";
          else if (document.querySelector('#buff_div_worker')) classType = "Munkás";
          else if (document.querySelector('#buff_div_soldier')) classType = "Katona";
          else if (document.querySelector('#buff_div_duelist')) classType = "Párbajhős";

          let profId = (typeof Character !== 'undefined' && Character.professionId) ? parseInt(Character.professionId, 10) : 0;

          return { name: charName, level: level, charClass: classType, professionId: profId };
      }

      function getServerName() {
          try { return window.location.hostname.split('.')[0]; } catch(e) { return "Ismeretlen"; }
      }

      function getTimeKeys(date) {
          let y = date.getFullYear();
          let m = String(date.getMonth() + 1).padStart(2, '0');
          let d = String(date.getDate()).padStart(2, '0');
          let h = String(date.getHours()).padStart(2, '0');

          let dayOfWeek = date.getDay();
          let diff = date.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1);
          let monday = new Date(date.getTime());
          monday.setDate(diff);
          let wy = monday.getFullYear();
          let wm = String(monday.getMonth() + 1).padStart(2, '0');
          let wd = String(monday.getDate()).padStart(2, '0');

          return {
              hourly: `${y}-${m}-${d} ${h}:00`,
              daily: `${y}-${m}-${d}`,
              weekly: `${wy}-${wm}-${wd} (Hét)`,
              monthly: `${y}-${m}`
          };
      }

      function getRealtimeGained(absoluteTotalXP, isDaily) {
          let now = new Date();
          let timeKeys = getTimeKeys(now);
          let activeKey = isDaily ? timeKeys.daily : timeKeys.hourly;

          let dateStorageKey = isDaily ? DAILY_START_DATE_KEY : HOURLY_START_DATE_KEY;
          let xpStorageKey = isDaily ? DAILY_START_XP_KEY : HOURLY_START_XP_KEY;

          let savedDate = localStorage.getItem(dateStorageKey);
          let startXP = parseInt(localStorage.getItem(xpStorageKey), 10);

          if (savedDate !== activeKey || isNaN(startXP)) {
              localStorage.setItem(dateStorageKey, activeKey);
              localStorage.setItem(xpStorageKey, absoluteTotalXP);
              return 0;
          }

          let gained = absoluteTotalXP - startXP;
          return gained > 0 ? gained : 0;
      }

  function calculateExactTargetETA(currentLevel, currentXPInLevel, maxXPInLevel, customTargetLevel = null) {
          if (currentLevel >= 250) return "Max. szint elértve!";

          let list = trackerData[projectionBasis] || [];
          if (list.length === 0) return "Nincs elég adat a becsléshez!";

          let totalGained = 0, count = 0;
          list.forEach(r => { let g = r.gained || 0; if (g > 0) { totalGained += g; count++; } });
          if (totalGained <= 0 || count === 0) return "Nincs elég adat a becsléshez!";

          let avgPerUnit = totalGained / count;
          let targetLvl = customTargetLevel !== null ? customTargetLevel : exactTargetLevel;
          if (targetLvl <= currentLevel) return "A célszint már el van érve!";

          let currentAbsXP = getTotalXPForLevel(currentLevel) + currentXPInLevel;
          let targetAbsXP = getTotalXPForLevel(targetLvl);
          let totalRemainingXP = targetAbsXP - currentAbsXP;

          let unitsLeft = totalRemainingXP / avgPerUnit;
          if (projectionBasis === 'hourly') {
              let hoursLeft = unitsLeft;
              if (hoursLeft > 24) return `${Math.floor(hoursLeft / 24)} nap ${Math.round(hoursLeft % 24)} óra`;
              else if (hoursLeft < 1) return `kb. ${Math.max(1, Math.round(hoursLeft * 60))} perc`;
              else return `${Math.floor(hoursLeft)} óra ${Math.round((hoursLeft - Math.floor(hoursLeft)) * 60)} perc`;
          } else {
              let daysLeft = unitsLeft;
              if (daysLeft >= 1) return `kb. ${Math.round(daysLeft)} nap`;
              else return `kb. ${Math.max(1, Math.round(daysLeft * 24))} óra`;
          }
      }

      function calculateCustomETAStr(currentLevel, currentXPInLevel, maxXPInLevel, targetLvl, customXp, basis) {
          if (currentLevel >= 250) return "Max. szint elértve!";
          if (!customXp || customXp <= 0) return "Adj meg egy érvényes TP-t!";
          if (targetLvl <= currentLevel) return "Ezt a szintet már elérted!";

          let currentAbsXP = getTotalXPForLevel(currentLevel) + currentXPInLevel;
          let targetAbsXP = getTotalXPForLevel(targetLvl);
          let totalRemainingXP = targetAbsXP - currentAbsXP;

          if (totalRemainingXP <= 0) return "Ezt a szintet már elérted!";

          let unitsLeft = totalRemainingXP / customXp;

          if (basis === 'hourly') {
              let hoursLeft = unitsLeft;
              if (hoursLeft > 24) {
                  let d = Math.floor(hoursLeft / 24);
                  let h = Math.round(hoursLeft % 24);
                  return `${d} nap ${h} óra`;
              }
              else if (hoursLeft < 1) return `kb. ${Math.max(1, Math.round(hoursLeft * 60))} perc`;
              else return `${Math.floor(hoursLeft)} óra ${Math.round((hoursLeft - Math.floor(hoursLeft)) * 60)} perc`;
          } else {
              let daysLeft = unitsLeft;
              if (daysLeft >= 1) {
                  let d = Math.floor(daysLeft);
                  let h = Math.round((daysLeft - d) * 24);
                  return `${d} nap ${h} óra`;
              }
              else return `kb. ${Math.max(1, Math.round(daysLeft * 24))} óra`;
          }
      }

      function getStatsForCurrentView() {
          let list = trackerData[currentView] || [];
          let now = new Date();
          let currentKeys = getTimeKeys(now);
          let activeKey = currentKeys[currentView];

          let prevVal = 0, prevPrevVal = 0, bestVal = 0, bestDate = "", totalGainedAll = 0, validCount = 0;

          let viewNames = {
              hourly: { current: "Előző Lezárt Óra", best: "Legjobb Órás Rekord", avgTitle: "Óránkénti Átlag" },
              daily: { current: "Előző Lezárt Nap", best: "Legjobb Napi Rekord", avgTitle: "Napi Átlag" },
              weekly: { current: "Előző Lezárt Hét", best: "Legjobb Heti Rekord", avgTitle: "Heti Átlag" },
              monthly: { current: "Előző Lezárt Hónap", best: "Legjobb Havi Rekord", avgTitle: "Havi Átlag" }
          };

          let lastItem = list.length > 0 ? list[list.length - 1] : null;
          let secondLastItem = list.length > 1 ? list[list.length - 2] : null;
          let thirdLastItem = list.length > 2 ? list[list.length - 3] : null;

          if (lastItem && lastItem.dateKey === activeKey) {
              prevVal = secondLastItem ? (secondLastItem.gained || 0) : 0;
              prevPrevVal = thirdLastItem ? (thirdLastItem.gained || 0) : 0;
          } else if (lastItem) {
              prevVal = lastItem.gained || 0;
              prevPrevVal = secondLastItem ? (secondLastItem.gained || 0) : 0;
          }

          list.forEach(r => {
              let g = r.gained || 0;
              if (g > bestVal) { bestVal = g; bestDate = r.dateKey || ""; }
              if (g > 0) { totalGainedAll += g; validCount++; }
          });

          let avgVal = validCount > 0 ? Math.round(totalGainedAll / validCount) : 0;

          let trendHtml = "";
          if (prevPrevVal > 0) {
              let diff = prevVal - prevPrevVal;
              let percent = Math.abs((diff / prevPrevVal) * 100).toFixed(1);
              if (diff > 0) {
                  trendHtml = `<br><span style="font-size: 10px; color: #00ff66; font-weight: bold; text-shadow: 1px 1px 2px black;">▲ ${percent}%</span>`;
              } else if (diff < 0) {
                  trendHtml = `<br><span style="font-size: 10px; color: #ff4a4a; font-weight: bold; text-shadow: 1px 1px 2px black;">▼ ${percent}%</span>`;
              } else {
                  trendHtml = `<br><span style="font-size: 10px; color: #ffcc00; font-weight: bold; text-shadow: 1px 1px 2px black;">▬ 0.0%</span>`;
              }
          } else if (prevVal > 0 && prevPrevVal === 0 && list.length > 1) {
              trendHtml = `<br><span style="font-size: 10px; color: #00ff66; font-weight: bold; text-shadow: 1px 1px 2px black;">▲ 100%</span>`;
          }

          let bestText = bestVal > 0 ? `+${safeLocStr(bestVal)} TP<br><span style="font-size: 10px; color: var(--tw-text-gold); font-weight: normal; text-shadow: 1px 1px 1px black;">(${bestDate})</span>` : "Nincs adat";

          return {
              titleCurrent: viewNames[currentView].current,
              titleBest: viewNames[currentView].best,
              titleAvg: viewNames[currentView].avgTitle,
              currentText: (prevVal > 0 ? `+${safeLocStr(prevVal)} TP` : "0 TP") + trendHtml,
              best: bestText,
              average: avgVal > 0 ? `+${safeLocStr(avgVal)} TP` : "Nincs adat"
          };
      }

