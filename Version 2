  // ===== Item stock forecast =====
  // Every successful item use of the script is recorded with its time, and every minute in which a bot
  // (jobs / duels / fort battle) is running is counted. rate = uses / running hours over the last 48 hours,
  // remaining = stock of the ticked items / rate. Only the script's own uses are counted.
  const FC_WIN = 48 * 3600000, FC_KEEP = 72 * 3600000
  let fcUses = {}, fcAct = {}
  function fcLoad() {
    fcUses = load('iu', {}) || {}
    fcAct = load('ia', {}) || {}
    fcPrune()
  }
  function fcPrune() {
    const lim = Date.now() - FC_KEEP
    for (const k of Object.keys(fcUses)) {
      fcUses[k] = (Array.isArray(fcUses[k]) ? fcUses[k] : []).filter(x => +x > lim)
      if (!fcUses[k].length) delete fcUses[k]
    }
    const hLim = Math.floor(lim / 3600000)
    for (const h of Object.keys(fcAct)) if (+h < hLim) delete fcAct[h]
  }
  function fcNoteUse(kind) {
    if (!kind) return
    ;(fcUses[kind] || (fcUses[kind] = [])).push(Date.now())
    if (fcUses[kind].length > 2000) fcUses[kind].splice(0, fcUses[kind].length - 2000)
    saveSoon('iu', () => fcUses)
  }
  function fcTick() {
    if (!(R.on || D.on || P.on || B.on || fortActive())) return
    const h = Math.floor(Date.now() / 3600000)
    fcAct[h] = Math.min(60, (+fcAct[h] || 0) + 1)
    if (Math.random() < 0.1) fcPrune()
    save('ia', fcAct)
  }
  function fcActiveHours() {
    const from = Math.floor((Date.now() - FC_WIN) / 3600000)
    let m = 0
    for (const h in fcAct) if (+h >= from) m += +fcAct[h] || 0
    return m / 60
  }
  function fcStock(kind) {
    const ids = listOf(kind).map(Number)
    const ticked = ids.reduce((a, id) => a + bagCount(id), 0)
    const others = catalog([kind]).filter(x => !ids.includes(x.id)).reduce((a, x) => a + x.c, 0)
    return { ticked, others, n: ids.length }
  }
  function fcLeft(h) {
    if (!(h > 0)) return t('fcNow')
    if (h >= 48) return t('fcDays', Math.floor(h / 24), Math.round(h % 24))
    if (h >= 1) { const m = Math.round(h * 60); return t('fcHours', Math.floor(m / 60), two(m % 60)) }
    return t('fcMin', Math.max(1, Math.round(h * 60)))
  }
  function fcWhen(ms) {
    const d = new Date(ms), n = new Date()
    const days = Math.round((new Date(d.getFullYear(), d.getMonth(), d.getDate()) - new Date(n.getFullYear(), n.getMonth(), n.getDate())) / 86400000)
    if (days <= 0) return clock(ms)
    if (days === 1) return t('fcTomorrow', clock(ms))
    return `${two(d.getMonth() + 1)}.${two(d.getDate())}. ${clock(ms)}`
  }
  function fcRow(kind) {
    const st = fcStock(kind), act = fcActiveHours()
    const from = Date.now() - FC_WIN
    const uses = (fcUses[kind] || []).filter(x => +x > from).length
    let rate = '—', left
    if (!st.n) left = t('fcNoTick')
    else if (st.ticked <= 0) left = t('fcEmpty')
    else if (act < 0.5) left = t('fcFewData')
    else if (!uses) left = t('fcNoUse')
    else {
      const r = uses / act
      rate = r >= 10 ? fmt(r) : r.toFixed(1).replace('.', lang() === 'hu' ? ',' : '.')
      const h = st.ticked / r
      left = fcLeft(h) + (h < 72 ? ' · ' + t('fcUntil', fcWhen(Date.now() + h * 3600000)) : '')
    }
    const warn = st.n && st.ticked > 0 && uses && act >= 0.5 && st.ticked / (uses / act) < 8
    return { kind, stock: st.ticked, others: st.others, rate, left, warn: warn || (st.n && st.ticked <= 0) }
  }


  // ===== Selling at the travelling trader (Union Pacific) =====
  // Captured call: remoteCall('shop_trader', 'sell', { inv_id, count, last_inv_id }) → { money, changes, error }.
  // Started by hand only. Never offered: worn items, items of any saved set, items of a game item set,
  // unsellable items, usable items (buffs, refills, chests…), recipes and the locked list.
  const CLOTH_TYPES = ['head', 'neck', 'body', 'right_arm', 'left_arm', 'belt', 'foot', 'animal', 'pants']
  const S = { rows: [], sel: {}, busy: false, at: 0, prog: '' }
  const invIdOf = w => +((w && (w.inv_id || w.invId || (w.obj && w.obj.inv_id))) || (w && typeof w.getInvId === 'function' ? w.getInvId() : 0)) || 0
  function lastInvId() {
    let m = 0
    try { m = +(W.Bag.last_inv_id || W.Bag.lastInvId || (typeof W.Bag.getLastInvId === 'function' ? W.Bag.getLastInvId() : 0)) || 0 } catch (e) {}
    try { for (const k in W.Bag.items_by_id) m = Math.max(m, invIdOf(W.Bag.items_by_id[k])) } catch (e) {}
    return m
  }
  const priceOf = o => +(o.sell_price != null ? o.sell_price : (o.price != null ? Math.floor(+o.price / 2) : 0)) || 0
  function setItemIds() {
    const ids = new Set()
    for (const g of gear) for (const k in g.items) if (g.items[k]) { ids.add(+g.items[k]); ids.add(Math.floor(+g.items[k] / 1000) * 1000) }
    return ids
  }
  function sellRows() {
    const sc = cfg.sell, inSets = setItemIds(), locked = new Set(sc.lock.map(Number)), out = []
    let src = {}
    try { src = W.Bag.items_by_id || {} } catch (e) {}
    for (const k in src) {
      const w = src[k], o = (w && w.obj) || w
      if (!o || !o.item_id) continue
      const id = +o.item_id, c = +(w.count != null ? w.count : 1) || 0, inv = invIdOf(w)
      if (c <= 0 || !inv || locked.has(id)) continue
      if (o.sellable === false || o.sellable === 0 || priceOf(o) <= 0) continue
      if (inSets.has(id) || inSets.has(Math.floor(id / 1000) * 1000) || isWorn(id)) continue
      if (o.set && String(o.set) !== '0' && String(o.set) !== 'null') continue
      if (lines(o).length || o.type === 'recipe') continue
      let kind = '', n = 0
      if (sc.clothes && CLOTH_TYPES.includes(o.type)) { kind = 'cloth'; n = c }
      else if (sc.products && o.type === 'yield') { kind = 'product'; n = c - Math.max(0, +sc.keepN || 0) }
      if (!kind || n <= 0) continue
      out.push({ id, inv, name: o.name || ('#' + id), type: o.type, kind, n, have: c, price: priceOf(o) })
    }
    return out.sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'cloth' ? -1 : 1) || b.price * b.n - a.price * a.n)
  }
  async function sellPrepare() {
    if (!gear.length) await loadGear()
    S.rows = sellRows()
    S.sel = {}
    for (const r of S.rows) S.sel[r.inv] = true
    S.at = Date.now()
  }
  async function sellRun() {
    if (S.busy) return
    const list = S.rows.filter(r => S.sel[r.inv])
    if (!list.length) { toast(t('sellNothing'), true); return }
    const total = list.reduce((a, r) => a + r.price * r.n, 0)
    if (!W.confirm(t('sellConfirm', list.length, fmt(list.reduce((a, r) => a + r.n, 0)), fmt(total)))) return
    S.busy = true
    let sold = 0, money = 0, fails = 0
    const m0 = G.money()
    try {
      await call('mode', 'shop_trader', 'index', { source: 'wear_window' }, 12000)
      // re-check every row just before selling (the bag or the sets may have changed)
      const fresh = new Map(sellRows().map(r => [r.inv, r]))
      for (let i = 0; i < list.length; i++) {
        const r = fresh.get(list[i].inv)
        S.prog = t('sellProg', i + 1, list.length)
        UI.redraw('sell')
        if (!r) continue
        const n = Math.min(r.n, list[i].n)
        const res = await call('remote', 'shop_trader', 'sell', { inv_id: r.inv, count: String(n), last_inv_id: lastInvId() }, 15000)
        if (!res || res.error) {
          fails++
          log(t('sellFail', r.name, (res && (res.msg || res.message)) || ''), 'w')
          if (fails >= 3) break
        } else {
          sold += n
          money += r.price * n
          try { if (res.money != null && typeof W.Character.setMoney === 'function') W.Character.setMoney(+res.money) } catch (e) {}
          try { if (Array.isArray(res.changes) && typeof W.Bag.updateChanges === 'function') W.Bag.updateChanges(res.changes) } catch (e) {}
          log(t('sellOne', n, r.name, fmt(r.price * n)))
        }
        await sleep(600 + Math.random() * 700)
      }
    } finally {
      S.busy = false
      S.prog = ''
    }
    const got = G.money() - m0
    log(t('sellDone', fmt(sold), fmt(got > 0 ? got : money)))
    toast(t('sellDone', fmt(sold), fmt(got > 0 ? got : money)))
    lastMoney = G.money()
    await sellPrepare()
    UI.redraw('sell')
  }


  // ===== Extra: prayer =====
  // Captured call: remoteCall('task', 'add', { tasks: { 0: { town_id, taskType: 'pray' } } }) → tasks with date_done (900 s each).
  // Prayer works in any town. If the character is not in a town it walks home first. The queue is kept full;
  // the end time of every prayer the script added is remembered, so free slots are known even when the game's
  // own queue list is not refreshed by the direct call.
  const PRAY_SEC = 900
  const P = { badTowns: {}, noTask: false, on: false, busy: false, gen: 0, since: 0, state: 'idle', note: '', town: null, walk: null, added: 0, startedAt: 0, ends: [], wait: 0, errors: 0, total: 0 }
  const pSet = (st, note) => { P.state = st; P.note = note || '' }
  const prayEndsLeft = () => { const n = G.now() / 1000; P.ends = P.ends.filter(x => x > n); return P.ends }
  const isPrayEntry = e => { const d = e && (e.data || e.data_obj || {}); return e && (e.type === 'pray' || d.name === 'pray' || d.taskType === 'pray') }
  function prayQueued() {
    const fromGame = G.queue().filter(isPrayEntry).length
    return Math.max(fromGame, prayEndsLeft().length)
  }
  function prayLimit() {
    const pc = cfg.pray
    if (pc.stop === 'count') return P.added >= Math.max(1, +pc.count || 1)
    if (pc.stop === 'hours') return Date.now() - P.startedAt >= Math.max(0.25, +pc.hours || 1) * 3600000
    return false
  }
  function praySave() { save('run', { kind: 'pray', t: Date.now(), added: P.added, startedAt: P.startedAt }) }
  async function prayFindTown(ck) {
    const pos = G.pos(), home = G.home()
    if (home && G.at(home)) return home
    const r = await call('mode', 'town', 'get_town', { x: String(pos.x), y: String(pos.y) }, 12000)
    ck()
    if (r && !r.error && r.town_id && G.at({ x: +r.town_x, y: +r.town_y })) return { id: +r.town_id, x: +r.town_x, y: +r.town_y, name: r.town_name || '' }
    return null
  }
  // no own town: the nearest town (from the minimap) whose church exists (building_church get_data → stage > 0)
  // ghost towns (abandoned towns without residents) are never chosen
  const GHOST_RE = /ghost|szellem|geister|widmo|fantom|duch|fantasma|abandon/i
  function isGhost(v) {
    if (!v || typeof v !== 'object') return false
    if (v.ghost === true || v.is_ghost === true || v.ghosttown === true) return true
    if (GHOST_RE.test(String(v.towntype || v.town_type || v.type || ''))) return true
    const m = v.member_count != null ? v.member_count : v.members
    if (m != null && +m <= 0) return true
    return GHOST_RE.test(String(v.name || v.town_name || '')) && /város|town|stadt|miasto/i.test(String(v.name || v.town_name || ''))
  }
  async function prayNearestTown(ck) {
    const r = await call('get', 'map', 'get_minimap', {}, 15000)
    ck()
    const raw = r && (r.towns || r.town || null)
    const list = []
    const push = (v, k) => {
      if (!v || typeof v !== 'object') return
      const x = +(v.x != null ? v.x : v.town_x != null ? v.town_x : (Array.isArray(v) ? v[0] : NaN))
      const y = +(v.y != null ? v.y : v.town_y != null ? v.town_y : (Array.isArray(v) ? v[1] : NaN))
      const id = +(v.town_id != null ? v.town_id : v.id != null ? v.id : k)
      if (!(id > 0) || !Number.isFinite(x) || !Number.isFinite(y)) return
      if (isGhost(v)) return
      list.push({ id, x, y, name: v.name || v.town_name || '' })
    }
    if (Array.isArray(raw)) raw.forEach(v => push(v))
    else if (raw && typeof raw === 'object') for (const k in raw) push(raw[k], k)
    if (!list.length) return null
    const pos = G.pos()
    const cands = list.filter(x => !P.badTowns[x.id]).map(x => Object.assign(x, { d: G.way(pos, x) })).sort((a, b) => a.d - b.d).slice(0, 12)
    for (const c of cands) {
      // check the town itself too (the minimap may not say whether it is a ghost town)
      const tw = await call('mode', 'town', 'get_town', { x: String(c.x), y: String(c.y) }, 12000)
      ck()
      if (!tw || tw.error || isGhost(tw) || (tw.town_id && +tw.town_id !== c.id)) { P.badTowns[c.id] = 1; await sleep(300 + Math.random() * 300); continue }
      if (tw.town_name) c.name = tw.town_name
      const ch = await call('mode', 'building_church', 'get_data', { town_id: c.id }, 12000)
      ck()
      if (ch && !ch.error && +ch.stage > 0) return c
      P.badTowns[c.id] = 1
      await sleep(300 + Math.random() * 300)
    }
    return null
  }
  async function prayAdd(town, n) {
    // preferred: the game's own task class, so the game's queue list stays up to date
    if (typeof W.TaskPray === 'function' && !P.noTask) {
      let got = 0
      for (let i = 0; i < n; i++) {
        const lastEnd = Math.max(G.now() / 1000, ...prayEndsLeft())
        const r = await addConfirmed(() => new W.TaskPray(town.id), isPrayEntry)
        if (!r.ok) break
        P.ends.push(lastEnd + PRAY_SEC)
        got++
        if (i < n - 1) await sleep(500 + Math.random() * 500)
      }
      if (got) return { ok: true, n: got }
      P.noTask = true
    }
    // fallback: the captured direct call
    const tasks = {}
    for (let i = 0; i < n; i++) tasks[i] = { town_id: town.id, taskType: 'pray' }
    const r = await call('remote', 'task', 'add', { tasks }, 15000)
    if (!r || r.error) return { ok: false, msg: (r && (r.msg || r.message)) || '' }
    const list = Array.isArray(r.tasks) ? r.tasks : Object.values(r.tasks || {})
    let got = 0
    for (const x of list) {
      const tk = x && (x.task || x)
      const done = +(tk && tk.date_done)
      if (done) { P.ends.push(done); got++ }
    }
    try { if (r.energy != null && typeof W.Character.setEnergy === 'function') W.Character.setEnergy(+r.energy) } catch (e) {}
    return { ok: got > 0, n: got }
  }
  async function prayStep(ck) {
    // fort battle coming: never queue a prayer that would end after the departure
    const fortAt = F.phase === 'plan' && F.depart > 0 ? F.depart : 0
    if (!P.town) {
      if (P.walk) {
        const home = P.walk.town
        if (G.at(home)) { P.town = home; P.walk = null; log(t('prayArrived', home.name || '')); return }
        const age = (Date.now() - P.walk.since) / 1000
        if ((G.qlen() === 0 && age > 20) || age > P.walk.eta + 180) { P.walk = null; return }
        pSet('walk', fmtDur(Math.max(0, P.walk.eta - age)))
        return
      }
      pSet('town')
      const town = await prayFindTown(ck)
      if (town) { P.town = town; log(t('prayTown', town.name || ('#' + town.id))); return }
      let home = G.home()
      if (!home) {
        home = await prayNearestTown(ck)
        if (!home) { prayStop(t('prayNoTown'), true); return }
        log(t('prayNearest', home.name || ('#' + home.id)))
      }
      if (typeof W.TaskWalk !== 'function') { prayStop(t('bankNoWalk'), true); return }
      if (G.qlen() > 0) { await cancelAll(); ck() }
      if (+cfg.travelSet) { await wear(cfg.travelSet, t('roleTravel'), true); ck() }
      const eta = G.way(G.pos(), home)
      const r = await addConfirmed(() => new W.TaskWalk(home.id, 'town'), isWalk)
      ck()
      if (!r.ok) { prayStop(t('prayWalkFail'), true); return }
      P.walk = { town: home, since: Date.now(), eta }
      log(t('prayWalk', home.name || ('#' + home.id), fmtDur(eta)))
      return
    }
    const queued = prayQueued()
    if (prayLimit()) {
      if (!queued) { prayStop(t('prayDone', fmt(P.added))); return }
      pSet('finish', t('prayLeft', queued))
      P.wait = Date.now() + 30000
      return
    }
    const cap = G.qcap()
    const other = Math.max(0, G.qlen() - G.queue().filter(isPrayEntry).length)
    let free = cap - Math.max(queued, G.qlen() - other) - other
    if (cfg.pray.stop === 'count') free = Math.min(free, Math.max(0, (+cfg.pray.count || 1) - P.added))
    if (fortAt) {
      const lastEnd = Math.max(G.now() / 1000, ...prayEndsLeft())
      const fit = Math.floor((fortAt - Date.now()) / 1000 / PRAY_SEC - Math.max(0, lastEnd - G.now() / 1000) / PRAY_SEC)
      free = Math.min(free, Math.max(0, fit))
    }
    if (free <= 0) {
      const next = prayEndsLeft().length ? Math.min(...P.ends) * 1000 - G.now() : 60000
      pSet('praying', t('prayQueued', queued, cap))
      P.wait = Date.now() + clamp(next + 2000, 5000, 120000)
      return
    }
    await sleep(800 + Math.random() * 1200)
    ck()
    const r = await prayAdd(P.town, free)
    ck()
    if (!r.ok) {
      P.errors++
      log(t('prayFail', r.msg || '—'), 'w')
      if (P.errors >= 3) { prayStop(t('prayTooMany'), true); return }
      // maybe this town cannot be used (no church) or we are not in a town any more: look again
      if (P.town && !(G.home() && P.town.id === G.home().id)) P.badTowns[P.town.id] = 1
      P.town = null
      P.wait = Date.now() + 20000
      return
    }
    P.errors = 0
    P.added += r.n
    P.total += r.n
    save('pt', P.total)
    praySave()
    log(t('prayAdded', r.n, fmt(P.added)))
    pSet('praying', t('prayQueued', prayQueued(), cap))
    UI.redraw('extra')
  }
  async function prayStart(restore) {
    if (P.on) return
    if (R.on || D.on || B.on) { toast(t('stopFirst'), true); return }
    if (fortBusy()) { toast(t('fortBusy'), true); return }
    P.on = true
    P.gen++
    P.busy = false
    P.town = null
    P.walk = null
    P.ends = []
    P.wait = 0
    P.errors = 0
    P.badTowns = {}
    P.added = restore ? +restore.added || 0 : 0
    P.startedAt = restore ? +restore.startedAt || Date.now() : Date.now()
    pSet('idle')
    praySave()
    log(t('prayStarted'))
    UI.redraw('extra')
  }
  function prayStop(msg, bad) {
    if (!P.on) return
    P.on = false
    P.gen++
    P.busy = false
    save('run', null)
    pSet('stopped')
    log(msg || t('prayStopped'), bad ? 'w' : '')
    if (msg) toast(msg, bad)
    UI.redraw('extra')
  }
  async function prayTick() {
    if (!P.on) return
    if (P.busy) {
      if (Date.now() - P.since > 240000) { P.gen++; P.busy = false; log(t('watchdog'), 'w') }
      return
    }
    if (P.wait > Date.now()) return
    P.busy = true
    P.since = Date.now()
    const g = P.gen
    const ck = () => { if (!P.on || g !== P.gen) throw ABORT }
    try { await prayStep(ck) } catch (e) {
      if (e !== ABORT) { log(t('error', (e && e.message) || e), 'e'); P.wait = Date.now() + 15000 }
    } finally { if (g === P.gen) P.busy = false }
  }


  // ===== Extra: duels against the residents of the bandit town ("Vizes banditák") =====
  // Captured: remoteCall('task', 'add', { tasks: { 0: { player_id, taskType: 'duel' } } }) → task of 600 s, costs 12 energy.
  // Residents: building_cityhall list_residents { town_id }. You must be a member of a town to duel.
  // The character walks to the town first – except a duelist inside the duel range (15 min, 30 min with automation).
  const WB_SEC = 600, WB_EN = 12
  const wbSetId = () => +cfg.wb.set || +cfg.duel.set || 0
  const B = { on: false, busy: false, gen: 0, since: 0, state: 'idle', note: '', added: 0, startedAt: 0, ends: [], wait: 0, errors: 0, total: 0, walk: null, noTask: false, bad: {}, ready: false }
  const bSet = (st, note) => { B.state = st; B.note = note || '' }
  const bEndsLeft = () => { const n = G.now() / 1000; B.ends = B.ends.filter(x => x > n); return B.ends }
  const isDuelEntry = e => { const d = e && (e.data || e.data_obj || {}); return e && (e.type === 'duel' || d.name === 'duel' || d.taskType === 'duel') }
  const bQueued = () => Math.max(G.queue().filter(isDuelEntry).length, bEndsLeft().length)
  const isDuelist = () => /duel/i.test(String(W.Character.charClass || W.Character.characterClass || ''))
  function duelRange() {
    let auto = false
    try { auto = !!W.Premium.hasBonus('automation') } catch (e) {}
    return (auto ? 30 : 15) * 60
  }
  function bLimit() {
    const c = cfg.wb
    if (c.stop === 'count') return B.added >= Math.max(1, +c.count || 1)
    if (c.stop === 'hours') return Date.now() - B.startedAt >= Math.max(0.25, +c.hours || 1) * 3600000
    return false
  }
  function bSave() { save('run', { kind: 'wb', t: Date.now(), added: B.added, startedAt: B.startedAt }) }
  async function wbFindTown(ck) {
    if (cfg.wb.town && cfg.wb.town.id) return cfg.wb.town
    // the name field may also hold coordinates ("14603, 16853")
    const xy = /^\s*(\d+)\s*[,; ]\s*(\d+)\s*$/.exec(String(cfg.wb.townName || ''))
    if (xy) {
      const tw = await call('mode', 'town', 'get_town', { x: xy[1], y: xy[2] }, 12000)
      ck()
      if (tw && !tw.error && +tw.town_id) { cfg.wb.town = { id: +tw.town_id, x: +tw.town_x, y: +tw.town_y, name: tw.town_name || '' }; saveCfg(); return cfg.wb.town }
      return null
    }
    const r = await call('get', 'map', 'get_minimap', {}, 15000)
    ck()
    const raw = r && (r.towns || r.town || null)
    const re = new RegExp(String(cfg.wb.townName || 'Vizes banditák').replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i')
    const all = Array.isArray(raw) ? raw : (raw && typeof raw === 'object' ? Object.entries(raw).map(([k, v]) => Object.assign({ _k: k }, v)) : [])
    for (const v of all) {
