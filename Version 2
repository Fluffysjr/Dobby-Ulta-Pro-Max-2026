      await deposit(b.town)
      ck()
      R.bankBlock = Date.now() + 60000
      idx.t = 0
      if (R.mode === 'bank') stopRun(t('bankDone'))
      return
    }
    const age = (Date.now() - b.since) / 1000
    if ((G.qlen() === 0 && age > 20) || age > b.eta + 180) {
      R.bank = null
      R.bankBlock = Date.now() + 1800000
      log(t('bankWalkFail'), 'w')
      if (G.qlen() > 0) await cancelAll()
      if (R.mode === 'bank') stopRun()
      return
    }
    setState('bank', fmtDur(Math.max(0, b.eta - age)))
  }
  function wakeReady(s) {
    if (s.reason === 'fort') return G.hPct() >= (+cfg.wakeHp || 60) && G.ePct() >= (+cfg.wakeEnergy || 100)
    const hpOk = G.hPct() >= Math.max((+cfg.hpStop || 0) + 1, s.reason === 'hp' ? +cfg.wakeHp || 0 : 0)
    if (s.reason === 'mot') return hpOk && G.energy() >= epj() && (s.wake || (cfg.motItemsOn && !!pickItem('mot').id))
    if (s.reason === 'hp') return hpOk && G.energy() >= epj()
    return hpOk && G.ePct() >= (+cfg.wakeEnergy || 100)
  }
  function wakeText(s) {
    if (s.reason === 'fort') return t('wakeFort', +cfg.wakeHp || 60, +cfg.wakeEnergy || 100)
    if (s.reason === 'mot') return t('wakeMot', two(+cfg.resetHour || 0))
    if (s.reason === 'hp') return t('wakeHp', Math.max((+cfg.hpStop || 0) + 1, +cfg.wakeHp || 0))
    return t('wakeEnergy', cfg.wakeEnergy)
  }
  async function sleepStep(ck) {
    const s = R.sleep
    const here = s.town && G.at(s.town)
    const entry = G.queue().find(G.isSleep)
    if (here && s.resleep) {
      s.resleep = false
      log(t('resleep'))
      if (entry && !(await cancelEntry(entry))) return
      ck()
      await wear(cfg.sleepSet, t('roleSleep'))
      ck()
      const r = await addSleep(s.town)
      ck()
      if (!r.ok) { R.sleep = null; return }
      s.t = Date.now()
      return
    }
    if (!entry) {
      if (Date.now() - s.t < 20000) return
      R.sleep = null
      log(t('sleepEnded'))
      return
    }
    if (!wakeReady(s)) { setState('sleep', wakeText(s)); return }
    log(t('wakeUp', G.energy(), G.maxEnergy(), G.hPct()))
    if (!(await cancelEntry(entry))) { warnOnce(t('cancelFail')); return }
    R.sleep = null
    idx.t = 0
  }

  const pickKey = p => `${p.id}@${p.x}-${p.y}`
  let picks = []
  const savePicks = () => save('p', picks)
  function stopOf(p) {
    if (R.mode === 'auto') return +cfg.xpStop || 0
    return p.stop != null && p.stop !== '' && Number.isFinite(+p.stop) ? +p.stop : +cfg.defStop || 0
  }
  function motOk(p) {
    const s = stopOf(p)
    if (s <= 0) return true
    const m = motOf(p.id)
    return m == null || m > s
  }
  function chooseTarget(list) {
    if (R.prefer) {
      const f = list.find(p => pickKey(p) === R.prefer)
      R.prefer = ''
      if (f) return f
    }
    if (list.length === 1 || R.mode !== 'list' || cfg.order === 'list') return list[0]
    if (cfg.order === 'rotate') { const x = list[R.rot % list.length]; R.rot++; return x }
    const here = G.pos()
    let best = list[0], bd = Infinity
    for (const p of list) {
      const d = G.at(p) ? 0 : G.way(here, p)
      if (d < bd) { bd = d; best = p }
    }
    return best
  }

  function silverBest(opts) {
    const pos = G.pos()
    const best = new Map()
    for (const s of spots) {
      const tier = tierOf(s)
      if (!tier || (tier === 2 && !opts.gold) || !canDo(s.id)) continue
      const lp = lpOf(s.id)
      if (opts.lpCheck && lp != null && lp < Math.max(1, +cfg.minLp || 0)) continue
      const d = G.way(pos, s)
      if (opts.maxDist > 0 && d > opts.maxDist) continue
      const cur = best.get(s.id)
      if (!cur || tier > cur.tier || (tier === cur.tier && d < cur.d)) best.set(s.id, { id: s.id, x: s.x, y: s.y, tier, d })
    }
    return [...best.values()]
  }
  async function measureList(list, ck) {
    let i = 0
    await pool(list, 2, async s => {
      if (ck) ck()
      const old = measOf(s.id, s.tier, 3600000)
      if (!old || (MG.cur === 'money' && old.g !== 'money')) { await measureSpot(s); await sleep(250 + Math.random() * 300) }
      UI.progress(t('measureProg', ++i, list.length))
    })
    UI.progress('')
  }
  const measuredBad = s => { const m = measOf(s.id, s.tier); return !!(m && m.lp != null && m.lp < 1) }
  const valOf = (s, goal) => goal === 'money' ? moneyOf(s.id, s.tier) : xpOf(s.id, s.tier).v
  async function rankSilver(n, ck, goal) {
    goal = goal === 'money' ? 'money' : 'xp'
    const c = ck || (() => {})
    if (!spots.length) await loadSpots()
    c()
    if (!fresh()) { const ok = await scanMap(); if (!ok) return [] }
    c()
    await wearMeasureGear(goal)
    c()
    await readIndex()
    c()
    const cands = silverBest({ gold: cfg.gold, lpCheck: !cfg.lpDress, maxDist: 0 })
      .sort((a, b) => valOf(b, goal) - valOf(a, goal))
    const top = cands.slice(0, Math.max(n * 3, 80))
    if (!top.length) return []
    log(t('pickMeasure', top.length))
    await measureList(top, ck)
    const score = s => valOf(s, goal)
    const okRaw = s => (+cfg.defStop <= 0 || motOf(s.id) == null || motOf(s.id) > +cfg.defStop) ? 1 : 0
    return top.filter(s => !measuredBad(s)).sort((a, b) => (okRaw(b) - okRaw(a)) || score(b) - score(a) || a.d - b.d)
  }
  let pickedFor = 0
  async function autoPick(ck) {
    setState('measure')
    const goal = cfg.f.goal
    const ranked = await rankSilver(+cfg.autoPickN || 6, ck, goal)
    if (!ranked.length) { log(t('pickNone'), 'w'); return }
    const chosen = ranked.slice(0, Math.max(1, +cfg.autoPickN || 6))
    picks = chosen.map(s => ({ id: s.id, x: s.x, y: s.y, tier: s.tier, stop: null, set: 0 }))
    savePicks()
    pickedFor = resetStart()
    save('pf', pickedFor)
    log(t('pickDone', chosen.map(s => `${jobName(s.id)} (${goal === 'money' ? '$' + fmt(moneyOf(s.id, s.tier)) : fmt(xpOf(s.id, s.tier).v) + ' XP'})`).join(', ')))
    UI.refresh()
  }
  // after a scan the list is only replaced once per daily reset,
  // or when a picked silver/gold job is no longer silver/gold (the server rotated late)
  function needReplan() {
    if (pickedFor < resetStart()) return true
    return picks.some(p => (p.tier || 0) > 0 && !feat.map[pickKey(p)])
  }

  const X = { cands: [], evalAt: 0 }
  const goalVal = s => cfg.autoGoal === 'money' ? moneyOf(s.id, s.tier) : xpOf(s.id, s.tier).v
  function pinSpots() {
    const pos = G.pos()
    const out = []
    for (const id of cfg.pins.map(Number)) {
      let best = null
      for (const s of spots) {
        if (s.id !== id) continue
        const tier = tierOf(s)
        if (tier === 2 && !cfg.gold) continue
        const d = G.way(pos, s)
        if (!best || tier > best.tier || (tier === best.tier && d < best.d)) best = { id, x: s.x, y: s.y, tier, d }
      }
      if (best && canDo(id)) out.push(best)
    }
    return out
  }
  async function autoEvaluate(ck) {
    setState('measure')
    if (!spots.length) await loadSpots()
    ck()
    if (!fresh()) { await scanMap(); ck() }
    await wearMeasureGear()
    ck()
    await readIndex()
    ck()
    const maxD = (+cfg.xpMaxDist || 0) * 60
    const by = new Map()
    if (fresh()) for (const s of silverBest({ gold: cfg.gold, lpCheck: !cfg.lpDress, maxDist: maxD })) by.set(s.id, s)
    for (const s of pinSpots()) {
      const cur = by.get(s.id)
      if (!cur || s.tier > cur.tier) by.set(s.id, Object.assign(s, { pin: true }))
      else cur.pin = true
    }
    const c = [...by.values()].sort((a, b) => goalVal(b) - goalVal(a)).slice(0, Math.max(5, +cfg.xpTop || 60))
    log(t('autoMeasure', c.length))
    await measureList(c, ck)
    ck()
    const pos = G.pos()
    for (const s of c) s.d = G.way(pos, s)
    const n = Math.max(1, Math.min(+cfg.maxQueue || 9, G.qcap()))
    const score = s => { const v = goalVal(s); return cfg.xpTravel ? v * n / (n * cfg.duration + s.d) : v }
    const minLp = Math.max(1, +cfg.minLp || 0)
    X.cands = c.filter(s => { if (cfg.lpDress) return true; const m = measOf(s.id, s.tier); return !(m && m.lp != null && m.lp < minLp) })
      .sort((a, b) => score(b) - score(a) || a.d - b.d)
      .map(s => ({ id: s.id, x: s.x, y: s.y, tier: s.tier, d: s.d, pin: !!s.pin, stop: null, set: 0 }))
    X.evalAt = Date.now()
    if (X.cands.length) log(t(cfg.autoGoal === 'money' ? 'autoBestMoney' : 'autoBestXp', jobName(X.cands[0].id), fmt(goalVal(X.cands[0]))))
    else log(t('autoNoCand'), 'w')
    UI.refresh('auto')
  }

  async function startRun(mode) {
    if (R.on) return
    if (D.on || P.on || B.on) { toast(t('stopFirst'), true); return }
    if (fortBusy()) { toast(t('fortBusy'), true); return }
    mode = mode || 'list'
    if (mode === 'list' && !picks.length && !cfg.autoPick) { toast(t('noPicks'), true); log(t('noPicks'), 'w'); return }
    R.on = true
    R.mode = mode
    R.gen++
    Object.assign(R, { busy: false, travel: null, sleep: null, wait: 0, hpWait: 0, gap: 0, hadQ: false, skip: {}, ignoreMot: false, prefer: '', bank: null, bankBlock: 0, startedAt: Date.now(), scanDue: false, build: null, buildDone: false })
    if (mode === 'list' || mode === 'auto') save('run', { kind: 'work', mode, t: Date.now() })
    X.evalAt = 0
    setState('idle')
    if (G.queue().some(G.isSleep)) R.sleep = { reason: 'energy', town: G.home(), t: Date.now(), resleep: false }
    lastExp = G.exp()
    lastMoney = G.money()
    lastTick = 0
    log(mode === 'auto' ? t('started_auto', t('goal_' + cfg.autoGoal)) : mode === 'bank' ? t('started_bank') : t('started_list', picks.length))
    UI.refresh()
    if (!gear.length) await loadGear()
    if (mode === 'bank') return
    if (!spots.length) await loadSpots()
    if (feat.scan < resetStart()) R.scanDue = true
    else if (mode === 'list' && cfg.autoPick && !picks.length) R.replan = true
  }
  function stopRun(msg, bad) {
    if (!R.on) return
    R.on = false
    save('run', null)
    R.gen++
    R.busy = false
    R.travel = null
    setState('stopped')
    log(msg || t('stopped'), msg ? 'w' : '')
    if (msg) toast(msg, bad)
    UI.refresh()
  }
  async function manual(mode, fn) {
    if (R.on || D.on) { toast(t('stopFirst'), true); return false }
    R.on = true
    R.mode = mode
    R.busy = true
    R.since = Date.now()
    const g = ++R.gen
    let res = false
    try { res = await fn(() => { if (g !== R.gen) throw ABORT }) } catch (e) { if (e !== ABORT) log(t('error', (e && e.message) || e), 'e') } finally {
      R.on = false
      R.busy = false
      R.gen++
      setState('stopped')
      UI.refresh()
    }
    return res
  }
  async function step() {
    if (!R.on || R.busy) return
    R.busy = true
    R.since = Date.now()
    const g = R.gen
    const ck = () => { if (!R.on || g !== R.gen) throw ABORT }
    try { await stepInner(ck) } catch (e) {
      if (e !== ABORT) log(t('error', (e && e.message) || e), 'e')
    } finally { if (g === R.gen) R.busy = false }
  }
  async function stepInner(ck) {
    if (R.sleep) return sleepStep(ck)
    if (F.pendingHotel) { F.pendingHotel = false; await goHotel('fort', ck); return }
    if (+cfg.hpStop > 0 && G.hPct() < +cfg.hpStop) {
      if (R.hpWait > Date.now()) return
      return lowHp(ck)
    }
    if (R.build || buildDue()) return buildStep(ck)
    if (R.bank) return bankStep(ck)
    if (R.travel) return travelStep(ck)
    if (G.qlen() > 0) { R.hadQ = true; setState('work', R.target ? jobName(R.target.id) : ''); return }
    if (R.hadQ) { R.hadQ = false; R.gap = Date.now() + rnd(cfg.dJob[0], cfg.dJob[1]) * 1000; idx.t = 0 }
    if (R.gap > Date.now()) { setState('pause', fmtDur((R.gap - Date.now()) / 1000)); return }
    if (R.wait > Date.now()) return
    if (fortHold()) { setState('wait', t('fortHoldNote')); return }
    if (R.scanDue) {
      R.scanDue = false
      setState('scan')
      const ok = await scanMap()
      ck()
      if (ok) {
        X.evalAt = 0
        if (R.mode === 'list' && cfg.autoPick && needReplan()) R.replan = true
      }
      return
    }
    if (R.mode === 'list' && R.replan) { R.replan = false; await autoPick(ck); return }
    if (R.mode === 'auto' && (!X.cands.length || Date.now() - X.evalAt > (+cfg.xpRescan || 30) * 60000)) {
      if (X.evalAt && !X.cands.length && Date.now() - X.evalAt < 300000) { setState('wait', t('autoNoCand')); R.wait = Date.now() + 60000; return }
      await autoEvaluate(ck)
      return
    }
    if (R.mode === 'bank' || R.bankForce || bankDue()) {
      R.bankForce = false
      setState('bank')
      const ok = await bankGo(ck)
      if (R.mode === 'bank' && (!ok || !R.bank)) stopRun(ok ? t('bankDone') : '')
      return
    }
    await maintainBuffs(ck)
    ck()
    const e = G.energy(), need = epj()
    if (e < need || (+cfg.energyAt > 0 && G.ePct() < +cfg.energyAt)) {
      const res = await refillEnergy(ck, e < need)
      if (res !== 'skip') return
    }
    if (Date.now() - idx.t > 15000) { setState('read'); await readIndex(); ck() }
    const all = R.mode === 'auto' ? X.cands : picks
    if (!all.length) {
      if (R.mode === 'list') { stopRun(t('noPicks')); return }
      X.evalAt = 0
      return
    }
    const targets = all.filter(p => !(R.skip[pickKey(p)] > Date.now()))
    if (!targets.length) { setState('wait', t('allSkipped')); R.wait = Date.now() + 60000; return }
    const okT = targets.filter(motOk)
    if (!okT.length) {
      if (targets.length < all.length) { setState('wait', t('allSkipped')); R.wait = Date.now() + 60000; return }
      const res = await noMotivation(ck)
      if (res !== 'continue') return
    } else R.ignoreMot = false
    const tgt = chooseTarget(okT.length ? okT : targets)
    await goWork(tgt, ck)
  }
  async function refillEnergy(ck, hard) {
    const p = pickItem('energy', 100 - G.ePct())
    if (p.id) {
      setState('item', t('kind_energy'))
      const ok = await useItem(p.id, 'energy', b => G.energy() > b.e)
      ck()
      if (ok) log(t('energyOk', G.energy(), G.maxEnergy()))
      return 'done'
    }
    if (!hard) return 'skip'
    if (!p.none && p.wait > 0 && cfg.energyOut !== 'hotel') {
      setState('wait', t('cdWait', fmtDur(p.wait / 1000)))
      R.wait = Date.now() + Math.min(p.wait + 3000, 600000)
      return 'done'
    }
    if (cfg.energyOut === 'wait') {
      setState('wait', t('energyRegen'))
      warnOnce(cfg.items.energy.length ? t('energyWait') : t('energyWaitNone'), 900000)
      R.wait = Date.now() + 60000
      return 'done'
    }
    if (cfg.energyOut === 'hotel') { await goHotel('energy', ck); return 'done' }
    stopRun(cfg.items.energy.length ? t('energyStop') : t('energyNone'))
    return 'done'
  }
  async function noMotivation(ck) {
    const p = cfg.motItemsOn ? pickItem('mot') : { id: 0, none: true }
    if (p.id) {
      setState('item', t('kind_mot'))
      const ok = await useItem(p.id, 'mot')
      ck()
      idx.t = 0
      if (ok) log(t('motItemOk'))
      return 'done'
    }
    if (!p.none && p.wait > 0 && cfg.motOut !== 'continue') {
      setState('wait', t('cdWait', fmtDur(p.wait / 1000)))
      R.wait = Date.now() + Math.min(p.wait + 3000, 600000)
      return 'done'
    }
    if (R.mode === 'auto' && Date.now() - X.evalAt > 600000) { X.evalAt = 0; return 'done' }
    if (cfg.motOut === 'continue') { if (!R.ignoreMot) log(t('motContinue'), 'w'); R.ignoreMot = true; return 'continue' }
    if (cfg.motOut === 'hotel') { log(t('motHotel'), 'w'); await goHotel('mot', ck); return 'done' }
    stopRun(t('motStop'))
    return 'done'
  }
  async function lowHp(ck) {
    if (G.qlen() > 0) {
      if (!cfg.hpCancel) { setState('work'); return }
      log(t('hpCancel', G.hPct()), 'w')
      await cancelAll()
      ck()
      R.travel = null
    }
    if (cfg.hpItemsOn) {
      if (+cfg.hpSet) { await wear(cfg.hpSet, t('roleHp')); ck() }
      if (G.hPct() >= +cfg.hpStop) return
      const p = pickItem('hp')
      if (p.id) {
        setState('item', t('kind_hp'))
        const ok = await useItem(p.id, 'hp', b => G.hp() > b.h)
        ck()
        if (ok) { await sleep(800); log(t('hpOk', G.hPct())) }
        return
      }
      if (!p.none && p.wait > 0 && cfg.hpOut !== 'hotel') {
        setState('wait', t('cdWait', fmtDur(p.wait / 1000)))
        R.hpWait = Date.now() + Math.min(p.wait + 3000, 600000)
        return
      }
    }
    if (cfg.hpOut === 'wait') { setState('wait', t('hpRegen')); warnOnce(t('hpWaitMsg'), 900000); R.hpWait = Date.now() + 60000; return }
    if (cfg.hpOut === 'hotel') { await goHotel('hp', ck); return }
    stopRun(t('hpStopMsg', G.hPct()), true)
  }
  function carriersFor(p) {
    const ids = new Set()
    for (const s of spots) if (s.x === p.x && s.y === p.y) ids.add(s.id)
    const gid = +(jobOf(p.id).groupid || jobOf(p.id).group_id || 0)
    if (gid) { try { for (const j of W.JobList.getJobsByGroupId(gid) || []) ids.add(+(j && typeof j === 'object' ? j.id : j)) } catch (e) {} }
    ids.delete(p.id)
    let list = [...ids].filter(id => id > 0 && canDo(id)).sort((a, b) => (+jobOf(a).malus || 0) - (+jobOf(b).malus || 0))
    const known = R.carriers[pickKey(p)]
    if (known && list.includes(known)) list = [known, ...list.filter(x => x !== known)]
    return list.slice(0, 6)
  }
  async function goWork(p, ck) {
    const need = epj()
    if (G.energy() < need) return
    let n = Math.min(+cfg.maxQueue || 9, G.qcap(), Math.floor(G.energy() / need))
    const stop = stopOf(p), m = motOf(p.id)
    if (!R.ignoreMot && stop > 0 && m != null) n = Math.min(n, m - stop)
    n = Math.max(1, n)
    R.target = p
    const key = pickKey(p)
    if (!G.at(p)) {
      const ts = +cfg.travelSet || 0
      if (ts && needTravelSwap(p) && !(R.noSpeed[key] > Date.now())) {
        setState('travel', jobName(p.id))
        if (!(await wear(ts, t('roleTravel')))) return
        ck()
        const eta = G.way(G.pos(), p)
        const r = await addJobs(p, 1)
        ck()
        if (r.ok) {
          R.travel = { p, since: Date.now(), eta }
          R.prefer = key
          log(t('travelGo', jobName(p.id), fmtDur(eta)))
          return
        }
        if (cfg.carrier) {
          for (const cid of carriersFor(p)) {
            const rc = await addJobs({ id: cid, x: p.x, y: p.y }, 1)
            ck()
            if (rc.ok) {
              R.carriers[key] = cid
              R.travel = { p, since: Date.now(), eta, carrier: cid }
              R.prefer = key
              log(t('carrierGo', jobName(cid), jobName(p.id), fmtDur(eta)))
              return
            }
          }
        }
        R.noSpeed[key] = Date.now() + 12 * 3600000
        log(t('travelReject', jobName(p.id)), 'w')
      }
    }
    if (!(await dressBefore(p))) return
    ck()
    setState('work', jobName(p.id))
    const r = await addJobs(p, n)
    ck()
    if (!r.ok) {
      if (G.energy() < need) return
      R.skip[key] = Date.now() + 10 * 60000
      log(t('addReject', jobName(p.id), r.msg || ''), 'w')
      return
    }
    R.hadQ = true
    log(t('queued', n, jobName(p.id), m == null ? '?' : m))
    await dressAfter(p)
  }
  async function travelStep(ck) {
    const tr = R.travel
    if (G.at(tr.p)) {
      R.travel = null
      log(t('arrived', jobName(tr.p.id)))
      if (G.qlen() > 0 && (tr.carrier || needTravelSwap(tr.p))) {
        setState('work')
        const ok = await cancelAll()
        ck()
        if (!ok) warnOnce(t('cancelFail'))
      }
      R.hadQ = G.qlen() > 0
      R.gap = 0
      idx.t = 0
      return
    }
    const age = (Date.now() - tr.since) / 1000
    if ((G.qlen() === 0 && age > 20) || age > tr.eta + 180) {
      R.travel = null
      if (!tr.carrier) R.noSpeed[pickKey(tr.p)] = Date.now() + 12 * 3600000
      log(t('travelLost'), 'w')
      if (G.qlen() > 0) await cancelAll()
      return
    }
    setState('travel', `${jobName(tr.p.id)} · ${fmtDur(Math.max(0, tr.eta - age))}`)
  }



  // ===== Fort battles =====
  // Reads "Aktuális erődharcok" (fort_overview) and every battle page (fort_battlepage index → joined, startTime in seconds),
  // walks to the earliest joined battle so it arrives cfg.fort.arrive minutes early, fills HP up to the fort-set maximum,
  // puts on the fort set, uses the two fixed buffs, then stops or waits for the end and resumes the previous bot.
  const F = { phase: 'idle', list: [], scanAt: 0, scanning: false, b: null, depart: 0, holdAt: 0, resume: null, busy: false, since: 0, gen: 0, wait: 0, note: '', done: {}, pendingHotel: false, err: '' }
  const fortActive = () => !['idle', 'plan'].includes(F.phase)
  const fortBusy = () => fortActive()
  const fortHold = () => F.phase === 'plan' && F.holdAt > 0 && Date.now() >= F.holdAt
  const fSave = () => save('fs', { phase: F.phase, b: F.b, resume: F.resume, done: F.done, t: Date.now() })
  const fSet = (ph, note) => { F.phase = ph; F.note = note || ''; fSave(); UI.redraw('fort') }
  const unesc = x => String(x || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#0?39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim()
  function parseWhen(txt) {
    const m = /(\d{1,2}):(\d{2})/.exec(txt || '')
    if (!m) return 0
    const sn = G.now(), pp = srvParts(sn)
    const day = /holnap|tomorrow|morgen|jutro|mâine|zítra/i.test(txt) ? 1 : 0
    const sinceMid = (pp.h * 3600 + pp.mi * 60 + pp.s) * 1000
    let target = sn - sinceMid + (day * 86400 + +m[1] * 3600 + +m[2] * 60) * 1000
    if (!day && target < sn - 6 * 3600000) target += 86400000
    return Date.now() + (target - sn)
  }
  async function fortScan() {
    if (F.scanning) return false
    F.scanning = true
    try {
      const r = await call('remote', 'fort_overview', '', { offset: 0 }, 15000)
      const html = r && r.page ? String(r.page) : ''
      if (!html) { F.err = t('fortScanFail'); return false }
      const a = html.indexOf('id="incomingbattle"')
      let sec = a >= 0 ? html.slice(a) : html
      const z = sec.indexOf('id="ownforts"')
      if (z > 0) sec = sec.slice(0, z)
      const found = []
      for (const part of sec.split('fortOverviewBox').slice(1)) {
        const id = /FortBattleWindow\.open\((\d+)/.exec(part)
        if (!id) continue
        const c = /GameMap\.center\((\d+)\s*,\s*(\d+)\)/.exec(part)
        const nm = /fo_fort_name[^>]*>([^<]*)</.exec(part)
        const tm = /class=["']fortBattle\d+["'][^>]*>([\s\S]*?)<\/span>/.exec(part)
        if (found.some(f => f.id === +id[1])) continue
        found.push({ id: +id[1], x: c ? +c[1] : 0, y: c ? +c[2] : 0, name: nm ? unesc(nm[1]) : '#' + id[1], when: tm ? unesc(tm[1]).replace(/^[^:]*:\s*/, '') : '' })
      }
      const list = []
      for (const f of found.slice(0, 10)) {
        const d = await call('mode', 'fort_battlepage', 'index', { fort_id: f.id }, 12000)
        await sleep(400 + Math.random() * 400)
        if (!d || d.error) continue
        if (d.coords && d.coords.x) { f.x = +d.coords.x; f.y = +d.coords.y }
        if (d.startTimeStr) f.when = String(d.startTimeStr)
        f.joined = !!d.joined
        f.running = !!d.inProgress
        f.start = Number.isFinite(+d.startTime) && d.startTime !== null && d.startTime !== '' ? Date.now() + +d.startTime * 1000 : parseWhen(f.when)
        const old = F.list.find(o => o.id === f.id && o.start)
        if (!f.start && old) f.start = old.start
        list.push(f)
      }
      F.list = list
      F.scanAt = Date.now()
      F.err = ''
      return true
    } finally { F.scanning = false }
  }
  function fortNext() {
    const now = Date.now()
    return F.list.filter(f => f.joined && f.start && f.x && !F.done[f.id + ':' + Math.round(f.start / 600000)] && (f.start > now - 60000 || f.running))
      .sort((a, b) => a.start - b.start)[0] || null
  }
  function fortPlan() {
    const b = fortNext()
    F.b = b
    if (!b) { F.depart = 0; F.holdAt = 0; return }
    const way = G.way(G.pos(), b) * 1000
    F.depart = b.start - way - (+cfg.fort.arrive || 10) * 60000 - 120000
    const pack = (+cfg.duration || 15) * 1000 * Math.max(1, +cfg.maxQueue || 4)
    F.holdAt = F.depart - pack - 60000
  }
  // fort buffs by default; "all" = every buff-type item (a bonus with a number), but never recipes, guides,
  // chests, bags or the plain energy / motivation / health refills
  const FORT_RE = /erődharc|erőd|fort ?battle|festungskampf|bitw|batal/i
  const NOT_BUFF_RE = /^(recept|útmutató|recipe|rezept|instructions?)\b|útmutató|ládája|láda\b|kosár|csomag|zsák|táska|hátizsák|chest|box|bag|sack|kiste|truhe|szett|set\b|kártya|card|munkaleírás|kazetta/i
  const CONTAINER_RE = /tartalmaz|gyűjtőkártya|következő(k| tárgyak)?b[óo]l|kinyit|contains?|one of the following|collect(ion|ible)|enthält|eines der folgenden|sammel|zawiera|jeden z|conține|obsahuje|contient|contiene/i
  const JOBTOOL_RE = /munkapont|labou?r points?|job points?|arbeitspunkt|punkt(y|ów)? pracy|puncte de muncă|pracovní bod|points? de travail|punti lavoro|puntos de trabajo/i
  const BATTLE_RE = /erőd|csat[aá]|harc|találat|kitér|célz|irányít|vezet|elrejt|bújk|sebz|kritik|ellenáll|védek|támad|kezdeményez|életerő ?pont|max(imális)? életerő|battle|fort|hit|dodg|aim|leader|hid(e|ing)|damage|crit|resist|defen|attack|initiative|health points?/i
  const NONBATTLE_RE = /párbaj|duel|szerencs|luck|tapasztalat|experience|fizetség|wage|munká|jobs?\b|menet|sebesség|speed|travel|termék|product|drop/i
  const isFortItem = o => FORT_RE.test(o.name || '') || lines(o).some(l => FORT_RE.test(l))
  const isBuffItem = o => {
    const ls = lines(o)
    if (!ls.length || NOT_BUFF_RE.test(o.name || '')) return false
    if (REFILLS.some(k => kindVal(o, k) != null)) return false
    // containers list drop chances as percentages ("Tartalmaz egyet a következőkből: 20,00% …") – not a buff
    if (ls.some(l => CONTAINER_RE.test(l))) return false
    // job tools ("+65 munkapont erre: Aranymosás") are for jobs, not for fort battles
    if (ls.some(l => JOBTOOL_RE.test(l))) return false
    // only battle-related bonuses (hit, dodge, aim, leadership, hiding, damage, health, resistance, …);
    // luck, XP, wages, travel speed, duel-only bonuses and the like stay out
    return ls.some(l => BATTLE_RE.test(l) && !NONBATTLE_RE.test(l) && /\d/.test(l))
  }
  const fortItems = () => {
    return bagList().filter(x => x.c > 0 && lines(x.o).length && (isFortItem(x.o) || (cfg.fort.allItems && isBuffItem(x.o))))
      .map(x => ({ id: +x.o.item_id, name: x.o.name || ('#' + x.o.item_id), c: x.c }))
      .sort((a, b) => a.name.localeCompare(b.name))
  }
  async function fortFillHp(target, ck, label) {
    for (let n = 0; n < 30 && G.hp() < Math.min(target, G.maxHp()); n++) {
      const pk = pickItem('hp')
      if (!pk.id) {
        if (!pk.none && pk.wait > 0 && pk.wait <= 120000) { fSet('prep', t('cdWait', fmtDur(pk.wait / 1000))); await sleep(pk.wait + 1000); ck(); continue }
        warnOnce(t('fortNoHpItem', G.hp(), target), 600000)
        return false
      }
      fSet('prep', t('fortFilling', label, G.hp(), Math.min(target, G.maxHp())))
      await useItem(pk.id, 'hp', x => G.hp() > x.h)
      ck()
      await sleep(800)
    }
    return true
  }
  async function fortUseBuff(id, ck) {
    if (!id) return
    if (bagCount(id) <= 0) { log(t('fortBuffMissing', itemLabel(id)), 'w'); return }
    const w = cdLeft(id)
    if (w > 0) {
      if (w > 180000) { log(t('fortBuffCd', itemLabel(id), fmtDur(w / 1000)), 'w'); return }
      fSet('prep', t('cdWait', fmtDur(w / 1000)))
      await sleep(w + 1000)
      ck()
    }
    const ok = await useItem(id, 'fort')
    ck()
    if (ok) log(t('fortBuffOk', itemLabel(id)))
  }
  async function fortStep(ck) {
    const fc = cfg.fort
    if (F.phase === 'idle' || F.phase === 'plan') {
      if (!fc.on) { if (F.phase !== 'idle') fSet('idle'); return }
      const near = F.b && F.depart - Date.now() < 3 * 3600000
      if (!F.scanAt || Date.now() - F.scanAt > (near ? 180000 : 600000)) { await fortScan(); ck() }
      fortPlan()
      if (!F.b) { if (F.phase !== 'idle') fSet('idle'); return }
      if (F.phase !== 'plan') fSet('plan')
      if (Date.now() < F.depart) return
      // departure: take over from the running bot
      const b = F.b
      F.resume = R.on && (R.mode === 'list' || R.mode === 'auto') ? { kind: 'work', mode: R.mode } : (D.on ? { kind: 'duel' } : (P.on ? { kind: 'pray', added: P.added, startedAt: P.startedAt } : (B.on ? { kind: 'wb', added: B.added, startedAt: B.startedAt } : null)))
      fSet('go')
      log(t('fortDepart', b.name, clock(b.start)))
      if (R.on) stopRun(t('fortTakeover', b.name))
      if (D.on) duelStop(t('fortTakeover', b.name))
      if (P.on) prayStop(t('fortTakeover', b.name))
      if (B.on) wbStop(t('fortTakeover', b.name))
      F.tries = 0
      return
    }
    const b = F.b
    if (!b) { fSet('idle'); return }
    if (F.phase === 'go') {
      if (G.at(b)) { fSet('prep'); F.arrivedAt = Date.now(); return }
      if (G.qlen() > 0) { await cancelAll(); ck() }
      if (typeof W.TaskWalk !== 'function') { fortAbort(t('bankNoWalk')); return }
      if (+cfg.travelSet) { await wear(cfg.travelSet, t('roleTravel'), true); ck() }
      const eta = G.way(G.pos(), b)
      const r = await addConfirmed(() => new W.TaskWalk(b.id, 'fort'), isWalk)
      ck()
      if (!r.ok) {
        if (++F.tries >= 3) { fortAbort(t('fortWalkFail', b.name)); return }
        F.wait = Date.now() + 20000
        return
      }
      F.walkSince = Date.now()
      F.eta = eta
      fSet('walk', fmtDur(eta))
      log(t('fortWalk', b.name, fmtDur(eta)))
      if (Date.now() + eta * 1000 > b.start) log(t('fortLate'), 'w')
      return
    }
    if (F.phase === 'walk') {
      if (G.at(b)) { fSet('prep'); F.arrivedAt = Date.now(); log(t('fortArrived', b.name)); return }
      const age = (Date.now() - F.walkSince) / 1000
      if ((G.qlen() === 0 && age > 20) || age > F.eta + 180) { fSet('go'); return }
      F.note = fmtDur(Math.max(0, F.eta - age))
      return
    }
    if (F.phase === 'prep') {
      if (Date.now() - F.arrivedAt < 3000) return
      if (!gear.length) await loadGear()
      const fs = +fc.set || 0, hs = +fc.hpSet || +cfg.hpSet || 0
      // 1) the target is the maximum health in the fort set (health is capped when switching to a smaller maximum)
      let target = G.maxHp()
      if (fs) { await wear(fs, t('roleFort'), true); ck(); await sleep(800); target = G.maxHp() }
      log(t('fortTarget', fmt(target)))
      // 2) fill in the health set, but never above the fort-set maximum
      if (hs && hs !== fs && G.hp() < target) {
        await wear(hs, t('roleHpFill'), true); ck(); await sleep(800)
        await fortFillHp(target, ck, setName(hs))
      }
      // 3) fort set on, fill the rest there (when the health set had a smaller maximum)
      if (fs) { await wear(fs, t('roleFort'), true); ck(); await sleep(800) }
      if (G.hp() < G.maxHp()) await fortFillHp(G.maxHp(), ck, fs ? setName(fs) : t('fortCurrentGear'))
      log(t('fortHpDone', G.hp(), G.maxHp()))
      // 4) the two fixed buffs, once per battle
      if (!b.buffed) {
